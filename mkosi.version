#!/bin/sh
# keel 的版本号:每次构建取一次 UTC 时间戳。
#
# 为什么是**可执行脚本**而不是一个静态文件:
# 静态版本号文件必须靠 `mkosi -B`(自动 bump)来推进,而那会**改写一个被 git 跟踪的文件**
# ⇒ 每次构建后工作区都是脏的,下次 `git pull` 直接冲突(真机上正是这样卡住的)。
# mkosi 官方支持"mkosi.version 可执行时运行它、用 stdout 当版本号"(见 mkosi 手册的 SCRIPTS 节),
# 于是版本号既不落盘也不冲突,而且天然唯一、单调递增。
date -u +%Y.%m.%d.%H%M
