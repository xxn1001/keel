#!/bin/bash
# os-rescue —— 救援与修复入口:重建 /data 骨架、请求重置 /etc、扩展 data 分区、
#              标记当前槽为坏、重装引导器。
#
# 见 docs/architecture.md §9(命令集)与 §4.2(/data 骨架);用户操作见
# docs/update.md §3.2(回滚/标记坏槽)与 docs/troubleshooting.md §3(/data 出问题)。
#
# 本脚本只做"幂等且只增不破"的修复:除了 --grow-data 会改分区表(只扩不缩),
# 没有别的破坏性动作 —— 清空 /etc 这种不可逆的事由 keel-mounts 在下次启动时做,
# 本脚本只放一个请求标志。
set -euo pipefail

# shellcheck source=/usr/lib/keel/lib.sh
# SC1091:脚本里写的是镜像内的绝对路径,而库的源文件在仓库的
# mkosi.extra/usr/lib/keel/lib.sh —— 静态检查工具按绝对路径找不到它,只能关掉这条提示。
#
# shellcheck disable=SC1091  # 注释与 source 行之间不能插别的东西
. /usr/lib/keel/lib.sh

readonly SKELETON="/usr/share/keel/data-skeleton"
readonly REPART_DEFS="/usr/lib/keel/repart.d"
readonly RESET_FLAG="/data/overlayfs/.reset-etc-requested"
readonly DATA_PART="/dev/disk/by-partlabel/data"

usage() {
    cat <<'EOF'
用法:os-rescue <--init-data|--reset-etc|--grow-data|--mark-bad|--repair-boot>

  --init-data   幂等修补 /data 骨架:把镜像里的骨架用 no-clobber 方式补进去,
                  不删除任何已有文件。骨架缺失、/var/lib/dbus/machine-id 链接
                  丢失(mkosi.finalize 里显式重建过,见 docs/traps.md 坑 #3)都走这里。
  --reset-etc     请求"下次启动清空 /etc 的可写层"。本命令**不清空**:只写标志文件
                  /data/overlayfs/.reset-etc-requested,由 keel-mounts 在挂载前
                  先把旧 upper 备份成 etc.bak-<时间戳>,再清空。
  --grow-data   用 systemd-repart 把 data 分区扩到整盘剩余空间(只扩不缩;
                  文件系统由 repart 的 GrowFileSystem 负责,不需要手动 resize2fs)。
  --mark-bad      把当前运行的这个槽标记为 bad(systemd-bless-boot bad),
                  让引导器以后不再选它。仅当另一个槽确实可用时才用。
  --repair-boot   重装 ESP 上的引导器并重建 NVRAM 启动项(bootctl install)。
EOF
}

need_root() {
    if [ "$(id -u)" != 0 ]; then
        keel_die "需要 root 权限,请用 sudo 重新执行"
    fi
}

# ---------------------------------------------------------------------------
# --init-data
#
# cp -a -n = 归档模式 + no-clobber:已存在的文件一律不动,**不删除任何东西**。
# 这正是"手贱清空 data"以及"骨架里少了个目录"两种故障的自愈入口(docs §7.2 ①)。
# 为什么用 cp 而不是 rsync:镜像里没有 rsync(见任务约束)。
# ---------------------------------------------------------------------------
do_init_data() {
    if [ ! -d "$SKELETON" ]; then
        keel_die "镜像里的骨架不存在:${SKELETON}(这个镜像不完整?)"
    fi
    if [ ! -d /data ]; then
        keel_die "/data 没有挂载。它是 initrd 按 kernel cmdline 的 systemd.mount-extra 挂的,先确认:findmnt /data"
    fi
    keel_log "把骨架补进 /data(已存在的文件不会被覆盖,也不会删除任何东西)"
    # 末尾的 /. 表示"复制目录内容"而不是目录本身
    cp -a -n "$SKELETON/." /data/ || keel_die "复制骨架失败(磁盘满了?)"
    sync

    # 两个最常见的"单独丢失"点,直接检查并报告,省得用户去猜。
    # readlink 对损坏的链接会失败,所以带 || true(set -e 下不能让它中断修复)。
    if [ -L /data/var/lib/dbus/machine-id ]; then
        keel_log "dbus machine-id 链接存在:$(readlink /data/var/lib/dbus/machine-id 2>/dev/null || echo '无法解析')"
    else
        install -d -m 0755 /data/var/lib/dbus
        ln -sfn /etc/machine-id /data/var/lib/dbus/machine-id
        keel_log "已重建 /data/var/lib/dbus/machine-id -> /etc/machine-id"
    fi
    [ -d /data/var/log/journal ] || keel_log "注意:/data/var/log/journal 仍然缺失,这次启动的日志会是易失的"

    echo "骨架修补完成。已有文件一件没动;缺的目录/文件/链接补上了。"
}

# ---------------------------------------------------------------------------
# --reset-etc
#
# 刻意**不在这里**清空 upper:清空必须发生在挂载 overlay **之前**,而运行中的系统
# 早就挂好了。所以本命令只留一个请求标志,真正的动作在 keel-mounts 里做(它会先备份)。
# ---------------------------------------------------------------------------
do_reset_etc() {
    if [ ! -d /data ]; then
        keel_die "/data 没有挂载,写不了请求标志;先确认:findmnt /data"
    fi
    if ! install -d -m 0755 /data/overlayfs; then
        keel_die "创建 /data/overlayfs 失败"
    fi
    if ! : >"$RESET_FLAG"; then
        keel_die "写请求标志失败:${RESET_FLAG}"
    fi
    sync
    keel_log "已写入请求标志:${RESET_FLAG}"
    echo "已登记请求:**下次启动**会把 /etc 的可写层清空,并重新从只读镜像播种。"
    echo "清空前 keel-mounts 会先把旧内容备份成:"
    echo "  /data/overlayfs/etc.bak-<时间戳>/"
    echo
    echo "注意:这样一来下面这些东西会回到出厂状态,而且不会自动恢复 ——"
    echo "  - 账号与密码(/etc/passwd、/etc/shadow、/etc/group)"
    echo "  - SSH 主机密钥(/etc/ssh/ssh_host_*)"
    echo "  - machine-id(/etc/machine-id,以及依赖它的 journal 关联)"
    echo "  - 网络配置、hostname、你改过的任何 /etc 下的文件"
    echo "要留的东西先复制到 /data/home/ 下面(那不在 overlay 的 upper 里)。"
    echo "备份不满意还能从上面那个 etc.bak-<时间戳> 目录里找回来。"
}

# ---------------------------------------------------------------------------
# --grow-data
#
# repart 按**分区类型**把定义匹配到现有分区,所以 /usr/lib/keel/repart.d 里的定义
# 必须和装机时的 30-data.conf 是同一个类型 UUID(见 repart/install/30-data.conf
# 的注释:刻意用项目私有 UUID,避免和 linux-generic 的 root-b 撞车)。
#
# TODO(待验证):"GrowFileSystem=yes 会顺带 resize2fs" 这个说法**站不住**:
#   读 systemd main 的源码,resize_fs() 只被 systemd-growfs 调用,
#   repart 自己从不 resize 已有文件系统(context_mkfs 里明写
#   `if (PARTITION_EXISTS(p)) continue;  /* Never format existing partitions */`),
#   GrowFileSystem= 只是把 GPT 的 bit 59 打上,交给 gpt-auto-generator 生成
#   systemd-growfs@.service —— 而我们的 data 分区是自己挂的(从前是 cmdline 的
#   systemd.mount-extra=PARTLABEL=data),不经过 gpt-auto-generator
#   (repart.d(5):这三个 flag "only affect automatic partition mounting")。
#   ⇒ 所以这一步只保证**分区**变大;文件系统要另外扩。2026-09 用 40G 假盘实测:
#   systemd-growfs /data 在这种"自己 mount(8) 挂的"挂载点上**会失败**
#   (它要的是 systemd 的 .mount 单元),所以现在的顺序是
#   "先试 systemd-growfs(把错误打出来)→ 失败就用 resize2fs 直接扩"(坑 #42)。
#   两个数字(分区 / 文件系统)都会打印出来,不一致就是没扩到位。
# ---------------------------------------------------------------------------
do_grow_data() {
    local pn rel disk part_bytes dev_bytes
    if [ ! -e "$DATA_PART" ]; then
        keel_die "找不到 data 分区:${DATA_PART}"
    fi
    pn="$(lsblk -no PKNAME "$(readlink -f "$DATA_PART")" 2>/dev/null | head -n1)" || pn=""
    if [ -z "$pn" ]; then
        keel_die "解析不出 data 分区所在的磁盘(lsblk -no PKNAME $(readlink -f "$DATA_PART") 没输出)"
    fi
    # lsblk 给出的 PKNAME 可能是分区名而不是整盘名(不同版本/不同插件对
    # by-partlabel 符号链接的处理不一样),所以再往上找一层,直到父设备是整盘。
    rel="$(lsblk -no TYPE "$(readlink -f "$DATA_PART")" 2>/dev/null | head -n1)" || rel=""
    if [ "$rel" != "disk" ]; then
        local pn2
        pn2="$(lsblk -no PKNAME "/dev/$pn" 2>/dev/null | head -n1)" || pn2=""
        # nvme0n1p2 的父设备是 nvme0n1(TYPE=disk),它自己没有父设备 —— lsblk 对
        # 整盘会打印空行,这里必须把它挡掉,否则 pn 会被清空。
        if [ -n "$pn2" ]; then
            pn="$pn2"
        fi
    fi
    if [ -b "/dev/$pn" ]; then
        disk="/dev/$pn"
    elif [ -b "$pn" ]; then
        disk="$pn"
    else
        keel_die "解析出的目标磁盘不存在:/dev/${pn}"
    fi
    [ -d "$REPART_DEFS" ] || keel_die "找不到 repart 定义目录:${REPART_DEFS}"

    part_bytes="$(blockdev --getsize64 "$(readlink -f "$DATA_PART")" 2>/dev/null)" || part_bytes=""
    dev_bytes="$(blockdev --getsize64 "$disk" 2>/dev/null)" || dev_bytes=""
    echo "目标磁盘 : ${disk}(${dev_bytes:-未知} 字节)"
    echo "data     : $(readlink -f "$DATA_PART")(当前 ${part_bytes:-未知} 字节)"
    echo "只扩不缩。分两步:repart 扩**分区**,systemd-growfs 扩**文件系统** ——"
    echo "repart 从不改动已存在分区的文件系统,GrowFileSystem= 只是个给"
    echo "systemd-gpt-auto-generator 看的 GPT 标志位,而我们不走那条路。"

    if ! command -v systemd-repart >/dev/null 2>&1; then
        keel_die "找不到 systemd-repart(systemd-repart 包没装?)"
    fi
    systemd-repart --dry-run=no --definitions="$REPART_DEFS" "$disk" ||
        keel_die "systemd-repart 失败。常见原因:目标盘上还有别的分区占着后面的空间、或定义里的类型 UUID 对不上现有 data 分区。"
    sync

    # 第二步:把文件系统顶满分到的新空间(ext4 在线扩容,resize2fs;e2fsprogs 提供)。
    # 为什么不用 systemd-growfs 当唯一手段(坑 #42,实测):Debian 的 systemd 包**不带**
    # 这个二进制,旧写法拿到的其实是 "command not found",还被 `>/dev/null 2>&1` 吞了。
    # 有就试一下(通用工具,按文件系统类型分派),没有就直接 resize2fs;已经到顶时它返回 0。
    data_dev="$(readlink -f "$DATA_PART")"
    if command -v systemd-growfs >/dev/null 2>&1; then
        if ! gf_out=$(systemd-growfs /data 2>&1); then
            keel_log "systemd-growfs 失败($gf_out),改用 resize2fs"
        fi
    fi
    if ! rs_out=$(resize2fs "$data_dev" 2>&1); then
        keel_die "resize2fs $data_dev 失败:$rs_out(e2fsprogs 装了吗?/data 是 ext4 吗?)"
    fi
    keel_log "resize2fs:$(printf '%s' "$rs_out" | tr '\n' ' ')"
    echo "现在的大小:分区 $(blockdev --getsize64 "$data_dev" 2>/dev/null) 字节 / 文件系统 $(df -P -B1 /data 2>/dev/null | awk 'NR==2{print $2}') 字节"
    echo "(文件系统比分区小 1~2% 是 ext4 元数据/保留块的正常开销,不是没扩到位)"

}

# ---------------------------------------------------------------------------
# --mark-bad
#
# systemd-bless-boot bad 会把当前条目的 tries-left 写成 0(等价于 +0-n.efi),
# 引导器据此在排序上把它排到最后(UAPI.1 Boot Loader Specification 的 boot counting)。
# 它依赖 LoaderBootCountPath 这个 EFI 变量,所以只有"带计数启动"的条目才有效。
# ---------------------------------------------------------------------------
do_mark_bad() {
    local slot other
    slot="$(keel_current_slot 2>/dev/null)" || slot=""
    if [ -z "$slot" ]; then
        keel_die "解析不出当前槽,拒绝标记(不确定自己在哪个槽上,标错就麻烦了)"
    fi
    other="$(keel_other_slot "$slot")"
    echo "  ************************************************************"
    echo "  即将把**当前正在运行**的槽 ${slot} 标记为 bad:"
    echo "  引导器以后不再优先选它。如果另一个槽并不可用,你会把自己锁在门外。"
    echo "  ************************************************************"

    if ! command -v systemd-bless-boot >/dev/null 2>&1; then
        keel_die "找不到 systemd-bless-boot(systemd-boot 包没装?)"
    fi
    systemd-bless-boot bad ||
        keel_die "systemd-bless-boot bad 失败:多半是这次启动没有 boot counting(LoaderBootCountPath 不存在),用 bootctl status 看当前条目名"

    keel_log "槽 ${slot} 已标记为 bad"
    echo "接下来:"
    echo "  sudo os-update switch ${other}   # 把 preferred 指向另一个槽的正式条目"
    echo "  sudo systemctl reboot            # 重启后确认新槽可用"
    echo "如果另一个槽的正式条目(keel-${other}.efi)不存在,它的条目名可能带计数"
    echo "(keel-${other}+N.efi):先用 bootctl list 看,再 bootctl set-preferred。"
}

# ---------------------------------------------------------------------------
# --repair-boot
#
# 主板固件可能清掉 NVRAM 里的启动项(R4),fallback 路径 EFI/BOOT/BOOTX64.EFI 能保证
# 还能起来;进来了就用这条命令把引导器与启动项重新装好(docs/architecture.md §5.2)。
# ---------------------------------------------------------------------------
do_repair_boot() {
    local slot counted f mnt
    slot="$(keel_current_slot 2>/dev/null)" || slot=""

    # ESP 没挂上就先挂 —— 这条命令本来就有"修引导"的职责,而 ESP 没挂上正是
    # 最常见的那种"引导看着没事、其实更新/确认全废"的状态(坑 #36)
    if [ "$KEEL_ESP_MOUNTED" != yes ]; then
        if mnt=$(keel_esp_mount); then
            keel_log "ESP 原来没挂上,已挂到 $mnt"
            KEEL_ESP=$mnt
            KEEL_UKI_DIR="$mnt/EFI/Linux"
            KEEL_ESP_MOUNTED=yes
        else
            keel_die "找不到/挂不上 PARTNAME=esp 的分区:先 lsblk -o NAME,SIZE,PARTLABEL 看有没有 esp;分区在但挂载失败就看 dmesg | tail 里 vfat 的报错(比如 FAT 损坏)"
        fi
    fi

    if bootctl install; then
        keel_log "bootctl install 完成(systemd-boot + fallback BOOTX64.EFI + NVRAM 启动项)"
    else
        keel_die "bootctl install 失败。检查:ESP($KEEL_ESP)是否已挂载且可写(findmnt $KEEL_ESP;mount -o remount,rw $KEEL_ESP)、固件是否允许写 EFI 变量、ESP 上是否有足够的空间。UEFI 下也可以靠 fallback 路径 EFI/BOOT/BOOTX64.EFI 启动。"
    fi
    sync

    if [ -z "$slot" ]; then
        keel_log "解析不出当前槽,跳过条目名检查"
        return 0
    fi
    if [ -e "$KEEL_UKI_DIR/keel-$slot.efi" ]; then
        keel_log "当前槽的正式条目存在:${KEEL_UKI_DIR}/keel-$slot.efi"
    else
        counted=""
        for f in "$KEEL_UKI_DIR/keel-$slot"+*.efi; do
            [ -e "$f" ] || continue
            counted="${f##*/}"
            break
        done
        if [ -n "$counted" ]; then
            echo "当前槽没有正式条目(keel-$slot.efi),但有带启动计数的条目:${counted}"
            echo "说明上次启动**没有**走到 boot-complete.target(systemd-bless-boot 没来得及改名)。"
            echo "如果这个槽其实是好的,可以让引导器继续用它:"
            echo "  sudo bootctl set-preferred ${counted}"
            echo "想让引导器认为它已经确认可用(去掉计数),可以:"
            echo "  sudo systemd-bless-boot good"
        else
            echo "当前槽在 ESP 上没有任何条目(keel-$slot.efi 或 keel-$slot+N.efi 都不存在)。"
            echo "这个槽可能从未被填充:用另一个槽启动,或 sudo os-update stage 重新写一次。"
        fi
    fi
}

# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------
need_root
[ "$#" -ge 1 ] || {
    usage
    exit 1
}

case "$1" in
    --init-data) do_init_data ;;
    --reset-etc) do_reset_etc ;;
    --grow-data) do_grow_data ;;
    --mark-bad) do_mark_bad ;;
    --repair-boot) do_repair_boot ;;
    -h|--help|help) usage ;;
    *) usage; keel_die "未知参数:$1" ;;
esac
