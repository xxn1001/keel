#!/bin/bash
# os-status —— 只读的系统状态报告:当前槽/版本/内核、pending 更新、上次更新结果、
#              /data 用量与布局版本、槽位分区、ESP 上的 UKI、/etc overlay 状态。
#
# 见 docs/architecture.md §9(命令集)与 §8(更新流程);更新时序见 §5.3。
# 出问题时先看这份报告,对应的排查入口见 docs/troubleshooting.md §3/§5。
#
# 设计约束:这是给人看的报告,**退出码永远为 0**。任何取不到的信息都写成
# "未知/不存在",绝不因为读不到某个文件而失败 —— 系统半坏的时候正是最需要它的时候。
set -euo pipefail

# shellcheck source=/usr/lib/keel/lib.sh
# SC1091:脚本里写的是镜像内的绝对路径,而库的源文件在仓库的
# mkosi.extra/usr/lib/keel/lib.sh —— 静态检查工具按绝对路径找不到它,只能关掉这条提示。
#
# shellcheck disable=SC1091  # 注释与 source 行之间不能插别的东西
. /usr/lib/keel/lib.sh

# ---------------------------------------------------------------------------
# 输出助手
#
# 把"命令失败"和"命令成功但输出为空"归一化成同一件事:状态报告里两者的结论
# 都是"未知",分开处理只会让下面每一行都多写一次 if。末尾的 || true 是为了在
# set -e 下也不让读取失败中断报告。
# ---------------------------------------------------------------------------
out_or() {
    local def="$1"
    shift
    local v
    v="$("$@" 2>/dev/null)" || v=""
    if [ -n "$v" ]; then
        printf '%s\n' "$v"
    else
        printf '%s\n' "$def"
    fi
}

# epoch 秒 → 人类可读。GNU date 对超范围数值会失败,所以退回显示原始秒数。
epoch_human() {
    local e="$1" v
    if [ -z "$e" ]; then
        printf '%s\n' "未知"
        return 0
    fi
    v="$(date -d "@$e" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null)" || v=""
    if [ -n "$v" ]; then
        printf '%s(epoch %s)\n' "$v" "$e"
    else
        printf '%s(原始 epoch 秒,无法解析)\n' "$e"
    fi
}

# 读取纯文本状态文件;失败或为空都输出空串
read_file() {
    local v
    v="$(cat "$1" 2>/dev/null)" || v=""
    printf '%s\n' "$v"
}

# 从 key=value 文件里取一个键(状态文件都是这个格式,见 lib.sh 的说明)
kv() {
    local v
    v="$(sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n1)" || v=""
    printf '%s\n' "$v"
}

hr() { printf '%s\n' "------------------------------------------------------------"; }

# ---------------------------------------------------------------------------
# 1) 版本 / 内核 / 当前槽
# ---------------------------------------------------------------------------
version="$(keel_version 2>/dev/null)" || version=""
# 末尾的 || version="" 是必需的:报告必须在任何环境下都跑到最后(退出码永远 0),
# 而管道里最后一个命令失败会让整个赋值语句非零退出。
[ -n "$version" ] || version="$(grep -E '^VERSION_ID=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"')" || version=""
[ -n "$version" ] || version="未知"
kernel="$(uname -r 2>/dev/null)" || kernel="未知"
slot="$(keel_current_slot 2>/dev/null)" || slot=""
[ -n "$slot" ] || slot="未知"

echo "keel 状态报告"
hr
echo "系统版本     : ${version}"
echo "内核         : ${kernel}"
echo "当前槽       : ${slot}"
if [ "$slot" = "未知" ]; then
    echo "               注意:/proc/cmdline 里没有 root=PARTLABEL=root-<a|b>。"
    echo "               可能是手动启动(例如 live U 盘),或引导参数被改过。"
fi

# ---------------------------------------------------------------------------
# 2) 上次启动结果与 pending 更新
#
# 这几个键由 keel-confirm.service 在 boot-complete.target 之后写(§5.3 ⑨⑩⑪),
# 所以它们是"上一次开机究竟发生了什么"的唯一权威来源。
# ---------------------------------------------------------------------------
last_result="$(keel_state_get last_result 2>/dev/null)" || last_result=""
last_ver="$(keel_state_get last_result_version 2>/dev/null)" || last_ver=""
last_time="$(keel_state_get last_result_time 2>/dev/null)" || last_time=""
running="$(keel_state_get running_slot 2>/dev/null)" || running=""
pending_slot="$(keel_state_get pending_slot 2>/dev/null)" || pending_slot=""
pending_ver="$(keel_state_get pending_version 2>/dev/null)" || pending_ver=""

echo "上次启动结果 : ${last_result:-无记录}"
echo "  版本       : ${last_ver:-未知}"
echo "  时间       : $(epoch_human "$last_time")"
echo "  观测到的槽 : ${running:-未知}"
if [ -n "$pending_slot" ]; then
    echo "待确认更新   : 槽 ${pending_slot},版本 ${pending_ver:-未知}"
    echo "               下次启动已指向槽 ${pending_slot};启动成功会自动确认,"
    echo "               连续 3 次没到 boot-complete 则自动回退(§5.3 ⑩⑪)。"
else
    echo "待确认更新   : 无"
fi

# ---------------------------------------------------------------------------
# 3) /data:挂没挂、用量、布局版本、swap
# ---------------------------------------------------------------------------
hr
if [ -d /data ]; then
    echo "/data 挂载  : $(out_or "未知(未挂载?)" findmnt -no SOURCE,FSTYPE /data)"
    echo "/data 用量  :"
    df -h /data 2>/dev/null | tail -n +2 | sed 's/^/  /' || echo "  未知(读不到 /data)"
else
    echo "/data      : 不存在(/data 没挂上,见 troubleshooting.md §3)"
fi

schema="$(read_file /data/keel/schema-version)"
echo "布局版本     : ${schema:-未知}(/data/keel/schema-version;当前镜像骨架是 1)"

# /data 空间的看门人结论(由 keel-data-guard.timer 写;决策 D23)。
# 为什么不在这里现算:回收动作只有定时器/启动时做,状态报告该显示"它上次看到了什么"。
guard=/data/keel/data-guard.state
if [ -r "$guard" ]; then
    gv="$(kv "$guard" verdict)"
    gavail="$(kv "$guard" avail_after)"
    case "$gv" in
        ok)        gtext="正常" ;;
        small)     gtext="正常(小分区/live 环境,只看不治)" ;;
        warn)      gtext="偏低" ;;
        critical)  gtext="严重不足(已自动回收)" ;;
        emergency) gtext="已耗尽(已自动回收 + 清掉 OTA 载荷)" ;;
        *)         gtext="未知" ;;
    esac
    if [ -n "$gavail" ]; then
        echo "空间看门人   : $gtext(上次检查时可用 $(awk -v b="$gavail" 'BEGIN{printf "%.0f MiB", b/1048576}'))"
    else
        echo "空间看门人   : $gtext"
    fi
    echo "               (keel-data-guard.timer 每次启动 3 分钟后 + 每天一次;日志 journalctl -u keel-data-guard)"
else
    echo "空间看门人   : 还没有结论(定时器没跑过?systemctl status keel-data-guard.timer)"
fi
case "$(kv "$guard" reserve)" in
    present)  echo "应急空间     : 已预留 256 MiB(/data/keel/.reserve,写满时自动交还)" ;;
    consumed) echo "应急空间     : **已被用掉过**(见 /data/keel/reserve-consumed;空间恢复后会重建)" ;;
    *)        echo "应急空间     : 无(小分区不建,见 keel-firstboot 第 6 步)" ;;
esac

# swap:swapon --show 在没有任何 swap 时输出为空且退出 0(不是错误)
swap_rows="$(swapon --show 2>/dev/null | tail -n +2)" || swap_rows=""
if [ -n "$swap_rows" ]; then
    echo "swap         :"
    printf '%s\n' "$swap_rows" | sed 's/^/  /'
else
    echo "swap         : 未启用(swapon --show 没有条目)"
fi

# ---------------------------------------------------------------------------
# 4) 两个槽的分区:存在性、大小
#
# 用 blockdev 拿精确字节数再换算成 GiB,避免 lsblk 的人类可读单位在不同版本间
# 格式不一致。分区设备一律走 /dev/disk/by-partlabel(槽的身份就是 PARTLABEL)。
# ---------------------------------------------------------------------------
hr
echo "槽位分区"
for s in a b; do
    dev="$(keel_slot_device "$s" 2>/dev/null)" || dev="/dev/disk/by-partlabel/root-$s"
    if [ -b "$dev" ]; then
        bytes="$(blockdev --getsize64 "$dev" 2>/dev/null)" || bytes=""
        if [ -n "$bytes" ]; then
            gib="$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1073741824}')"
            human="$(lsblk -dn -o SIZE "$dev" 2>/dev/null)" || human=""
            info="${human:-?}(${gib} GiB)"
        else
            info="大小未知"
        fi
        mark=""
        if [ "$slot" = "$s" ]; then
            mark="  <== 当前运行槽"
        fi
        echo "  root-$s : 存在 ${info}${mark}"
    else
        echo "  root-$s : 不存在或无权限(${dev})"
    fi
done

# ---------------------------------------------------------------------------
# 5) ESP 上的 UKI
#
# 文件名里的计数不是噪音(§5.3 ⑧):keel-b+2-1.efi 表示"新槽已尝试并失败过一次",
# 计数归零后引导器会跳过它。这里标出当前槽那几条,一眼就能看出是不是在重试。
# ---------------------------------------------------------------------------
hr
if [ "$KEEL_ESP_MOUNTED" = yes ]; then
    echo "ESP 挂载     : $KEEL_ESP($(out_or "?" findmnt -no SOURCE,FSTYPE "$KEEL_ESP"))"
else
    echo "ESP 挂载     : 没有挂上(期望 $KEEL_ESP_MOUNT)"
    echo "               警告:下面这一节看到的是只读镜像里的空目录,不是 ESP 的内容!"
    echo "               后果:os-update 写不进新 UKI、bootctl set-default 切不了槽、"
    echo "               keel-confirm 确认不了槽(docs/traps.md 坑 #36)。"
    echo "               自救:sudo os-rescue --repair-boot,或 systemctl restart keel-mounts"
fi
echo "ESP 上的 UKI(目录 $KEEL_UKI_DIR)"
found_uki=0
if [ -d "$KEEL_UKI_DIR" ]; then
    for f in "$KEEL_UKI_DIR"/*.efi "$KEEL_UKI_DIR"/*.failed; do
        # 目录为空或没有匹配时 glob 会原样返回,$f 就不存在,用 -e 过滤掉
        [ -e "$f" ] || continue
        found_uki=1
        base="$(basename "$f")"
        note=""
        case "$base" in
            "keel-$slot.efi") note="  <== 当前槽的正式条目" ;;
            "keel-$slot"+*.efi) note="  <== 当前槽的带计数条目(尝试中/未确认)" ;;
            "keel-$slot.efi.failed") note="  <== 当前槽曾启动失败" ;;
            "keel-$slot.efi.bad") note="  <== 当前槽已被标记为坏" ;;
            *) : ;;
        esac
        echo "  $base${note}"
    done
elif [ "$KEEL_ESP_MOUNTED" != yes ]; then
    echo "  跳过:ESP 没挂上(见上面那行警告)"
else
    echo "  目录不存在:$KEEL_UKI_DIR"
fi
if [ "$found_uki" -eq 0 ] && [ "$KEEL_ESP_MOUNTED" = yes ]; then
    echo "  没有任何 UKI 条目 —— 引导器不会列出 keel 的启动项"
fi

# ---------------------------------------------------------------------------
# 6) /etc 是否已经是 overlayfs
#
# 必须是 overlay(不变量 5)。不是的话说明 keel-mounts.service 没跑成:此时
# /etc 就是只读镜像里的目录,改动重启即丢(坑 #8 的排序要求)。
# ---------------------------------------------------------------------------
hr
etc_fstype="$(out_or "未知" findmnt -no FSTYPE /etc)"
if [ "$etc_fstype" = "overlay" ]; then
    echo "/etc         : overlayfs(可写层已挂载)"
else
    echo "/etc         : ${etc_fstype}"
    echo "               警告:不是 overlay,keel-mounts.service 可能失败了;"
    echo "               此时改 /etc 不会持久化:systemctl status keel-mounts.service"
fi

# ---------------------------------------------------------------------------
# 7) 网络:机器 ID、链路、地址、DNS
#
# 为什么把 machine-id 放在网络这一节:它坏掉时**唯一**明显的症状就是
# "networkd 的 DHCP 起不来"(坑 #29 —— DUID 默认要 machine-id,拿不到就是
# -ENOPKG,报错文字还是误导性的 "Package not installed")。
# 顺手也能看出 IPv6 稳定地址、resolved 的 DNSSEC 为什么不动。
# ---------------------------------------------------------------------------
hr
echo "网络"
mid="$(read_file /etc/machine-id)"
if printf '%s' "$mid" | grep -qxE '[0-9a-f]{32}'; then
    echo "  机器 ID    : ${mid}"
else
    echo "  机器 ID    : 无效或缺失(${mid:-空})"
    echo "               警告:依赖 machine-id 的功能都会拿到 -ENOPKG —— 最典型的是"
    echo "               networkd 的 DHCPv4(坑 #29)。手动修(注意光跑 systemd-machine-id-setup"
    echo "               没用,它对 uninitialized 是空转的):"
    echo "                 : > /etc/machine-id && systemd-machine-id-setup && systemctl restart systemd-networkd"
fi

links="$(networkctl list --no-pager --lines=0 2>/dev/null \
    | awk '$1 ~ /^[0-9]+$/ { printf "  %-10s %-13s %s\n", $2, $4, $5 }')" || links=""
if [ -n "$links" ]; then
    echo "  链路       :"
    printf '%s\n' "$links"
else
    echo "  链路       : 未知(systemd-networkd 没在跑?systemctl status systemd-networkd)"
fi

addrs="$(ip -4 -o addr show scope global 2>/dev/null | awk '{ printf "  %-10s %s\n", $2, $4 }')" || addrs=""
if [ -n "$addrs" ]; then
    echo "  IPv4 地址  :"
    printf '%s\n' "$addrs"
else
    echo "  IPv4 地址  : 无(DHCP 没拿到?journalctl -u systemd-networkd -b)"
fi

dns="$(resolvectl status --no-pager 2>/dev/null \
    | awk '/Current DNS Server:|DNS Servers:/ { sub(/^[ \t]+/, ""); print "  " $0 }' | head -n4)" || dns=""
if [ -n "$dns" ]; then
    echo "  DNS        :"
    printf '%s\n' "$dns"
else
    echo "  DNS        : 未知(systemd-resolved 没在跑?/etc/resolv.conf 指向它的 stub)"
fi

# ---------------------------------------------------------------------------
# 8) 更新源配置(只报告,不探测可达性 —— 那要联网,不该由状态报告承担)
# ---------------------------------------------------------------------------
hr
src="$(keel_conf UPDATE_SOURCE "" 2>/dev/null)" || src=""
if [ -n "$src" ]; then
    echo "更新源       : ${src}"
else
    echo "更新源       : 未配置(改 /data/keel/config 的 UPDATE_SOURCE=)"
fi
swap_cfg="$(keel_conf SWAPFILE_SIZE "" 2>/dev/null)" || swap_cfg=""
echo "swapfile 配置: ${swap_cfg:-留空 = min(内存, 8G) 且不小于 1G}"

# ---------------------------------------------------------------------------
# 9) 登录账号(决策 D21:admin 是唯一交互账号,root 锁定)
#
# 只读 /etc/shadow 的第二个字段来判断,不去问 PAM —— 系统半坏的时候正是最需要
# 这一节的时候,而"能不能登录"必须能离线判断。
# ---------------------------------------------------------------------------
hr
admin_sh="$(awk -F: '$1=="admin"{print $2}' /etc/shadow 2>/dev/null)" || admin_sh=""
sudoers="/etc/sudoers.d/10-keel-admin"
case "$admin_sh" in
    '')   admin_pw="未知(读不到 /etc/shadow?)" ;;
    \$*)  admin_pw="已设置(构建时 -p / mkosi.rootpw 给的初始密码)" ;;
    *)    admin_pw="**未设置**(shadow 字段 '$admin_sh')⇒ 只能用 SSH 公钥登录" ;;
esac
echo "登录账号     : admin(uid $(id -u admin 2>/dev/null || echo '不存在!'))"
echo "  admin 密码 : $admin_pw"
echo "  sudo       : $([ -r "$sudoers" ] && echo "已配置($sudoers,需要密码)" || echo "**缺 $sudoers**")"
echo "  root       : SSH 侧 PermitRootLogin no"
root_sh="$(awk -F: '$1=="root"{print $2}' /etc/shadow 2>/dev/null)" || root_sh=""
case "$root_sh" in
    '!'*|'*'*) echo "               账号已锁定(shadow '$root_sh')⇒ 控制台也登不进去,这是预期" ;;
    \$*)       echo "               **账号未锁定** —— 不该出现,见决策 D21 / os-rescue --reset-etc" ;;
    *)         echo "               状态未知(shadow 字段 '$root_sh')" ;;
esac

exit 0
