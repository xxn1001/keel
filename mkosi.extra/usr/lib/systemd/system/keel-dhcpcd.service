[Unit]
Description=keel: dhcpcd DHCP 客户端
Documentation=man:dhcpcd(8)
# 为什么不用 Debian 的 dhcpcd.service:它在 dhcpcd5 包里(带 sysv 脚本),
# 而 dhcpcd-base 只有二进制 ⇒ 镜像里会出现"有 dhcpcd 命令但没有单元"的怪状态(真踩过)。
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=exec
ExecStart=/usr/sbin/dhcpcd --quiet --waitip=4
ExecReload=/usr/sbin/dhcpcd --reboot
Restart=on-failure

[Install]
WantedBy=multi-user.target
