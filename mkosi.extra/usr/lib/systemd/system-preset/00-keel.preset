# keel:把本项目需要的单元显式钉成"启用"
#
# 为什么必须有这个文件:mkosi 构建时会执行 `systemctl preset-all`,
# 而 preset 规则是**按文件名排序、第一条匹配的规则生效**。
# 用 00- 前缀把我们的意图排在最前面,就不会被发行版自带策略覆盖。
#
# 只有 [Install] 段落还不够:preset 可能把没有匹配规则的单元判为禁用。

# keel 自己的单元
enable keel-mounts.service
enable keel-firstboot.service
enable keel-confirm.service
# 启动失败进 emergency/rescue 时的自动重启(决策 D26)
enable keel-boot-failed-reboot.service
enable keel-swapfile.service
# /data 的空间看门人与 nix GC(决策 D23):两个都是定时器,服务本身由定时器拉起
enable keel-data-guard.timer
enable keel-nix-gc.timer
# 更新**检查**(v1.1 ③):定时器只跑只读的 os-update check + 写结论 + 记日志。
# **刻意不启用任何"自动 fetch/stage"** —— 自动更新必须排在 v1.2 的更新签名之后
# (roadmap §0 硬约束 1)。要改策略先改那条约束,别只改这里。
enable keel-update-check.timer

# 网络(main 用 systemd 原生栈,决策 D15;Debian 默认不启用这两个)
enable systemd-networkd.service
enable systemd-networkd.socket
enable systemd-resolved.service
enable systemd-timesyncd.service

# 远程访问
enable ssh.service

# nix(Debian 的 nix-setup-systemd 提供;哪个存在就启用哪个)
enable nix-daemon.service
enable nix-daemon.socket

# ---------------------------------------------------------------------------
# 明确**不启用**的:systemd-pcrlock-*(决策 D20:v1 不做 Secure Boot / measured boot)
#
# 这些单元由发行版自己的 preset 启用,会在 TPM 存在的机器上真的跑起来
# (2026-09 实测:mkosi 的 QEMU 带 vTPM ⇒ 6 个单元失败、1 个成功;原因见
#  mkosi.postinst 里那段注释)。这里显式 disable 是为了不留悬空的 enable 链接;
# mkosi.postinst 还会把它们 mask 成 /dev/null,双保险。
# 将来做 Secure Boot / TPM 封印时要把这段删掉(见 docs/roadmap.md)。
# ---------------------------------------------------------------------------
disable systemd-pcrlock-file-system.service
disable systemd-pcrlock-firmware-code.service
disable systemd-pcrlock-firmware-config.service
disable systemd-pcrlock-machine-id.service
disable systemd-pcrlock-make-policy.service
disable systemd-pcrlock-secureboot-authority.service
disable systemd-pcrlock-secureboot-policy.service
disable systemd-pcrlock.socket
