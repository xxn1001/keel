#!/bin/bash
# keel 启动早期挂载:挂 /Volume、在 /etc 上挂 overlayfs、把 /home 与 /nix 绑到 /Volume 下
#
# 由 keel-mounts.service 调用,必须极早运行(见 AGENTS.md 不变量 1/2/5、
# 已知的坑 #8/#24,docs/architecture.md §4.1 §4.3)。
set -euo pipefail
. /usr/lib/keel/lib.sh

# ---------------------------------------------------------------------------
# /Volume:必须在这里挂 —— **不能**交给 kernel cmdline 的 systemd.mount-extra
#
# 曾经的写法是 cmdline 里 systemd.mount-extra=PARTLABEL=volume:/Volume:ext4:rw,noatime,
# 真机(VM)实测会死锁,详见 AGENTS.md 坑 #24:
#   * 该 cmdline 在主系统里生成 Volume.mount 单元,它 Requires/After
#     dev-disk-by-partlabel-volume.device —— 要等 udev 建出 by-partlabel 符号链接;
#   * 主系统 udev 要等 systemd-sysusers,而 sysusers 需要**可写的 /etc**;
#   * 可写的 /etc 是本脚本挂的 overlay(upper/work 在 /Volume 上)⇒ 回到第一点。
#   * 表现:systemd 破环时丢掉 local-fs-pre.target,udev 被推到 emergency 之后,
#     所有 by-partlabel 挂载 90s 超时 ⇒ local-fs.target 失败 ⇒ emergency mode。
# 所以改成自己挂,而且**不依赖 udev**:内核在 /sys 的 uevent 里直接给出 GPT 分区名
# (PARTNAME=)。blkid 只是兜底(它直接读文件系统超级块,同样不需要 udev)。
# ---------------------------------------------------------------------------
keel_find_volume() {
    local p dev
    for p in /sys/class/block/*; do
        [ -r "$p/uevent" ] || continue
        if grep -qx 'PARTNAME=volume' "$p/uevent" 2>/dev/null; then
            printf '/dev/%s' "${p##*/}"
            return 0
        fi
    done
    if command -v blkid >/dev/null 2>&1; then
        dev=$(blkid -o device -t LABEL=volume 2>/dev/null | head -n1) || dev=
        if [ -n "$dev" ]; then printf '%s' "$dev"; return 0; fi
    fi
    return 1
}

if ! mountpoint -q /Volume; then
    dev=$(keel_find_volume) || keel_die "找不到 PARTNAME=volume / LABEL=volume 的分区,无法挂载 /Volume。系统状态不可信,请用救援盘(os-rescue)检查分区表"
    install -d -m 0755 /Volume
    mount -t ext4 -o rw,noatime "$dev" /Volume
    keel_log "已把 $dev 挂到 /Volume"
fi

# ---------------------------------------------------------------------------
# 处理"恢复出厂 /etc"的请求(os-rescue --reset-etc 写下的标志)
#
# 必须在挂 overlay 之前做。旧的可写层整体改名保留成备份而不是删除 ——
# 那里面装着账号、SSH 主机密钥、machine-id、Wi-Fi 密码,直接删掉不可逆。
# ---------------------------------------------------------------------------
if [ -e /Volume/overlayfs/.reset-etc-requested ]; then
    ts=$(date +%Y%m%d-%H%M%S)
    bak="/Volume/overlayfs/etc.bak-$ts"
    keel_log "收到恢复出厂 /etc 的请求:旧的可写层备份到 $bak(不会删除)"
    mv /Volume/overlayfs/etc/upper "$bak"
    # workdir 里可能残留指向旧 upper 的条目,一并重建,否则 overlayfs 会拒绝挂载
    rm -rf /Volume/overlayfs/etc/work
    install -d -m 0755 /Volume/overlayfs/etc/upper /Volume/overlayfs/etc/work
    rm -f /Volume/overlayfs/.reset-etc-requested
fi

# ---------------------------------------------------------------------------
# /home:必须是**真实挂载点**
#
# 符号链接会让 ProtectHome= 之类的沙箱设置失效(服务仍能通过 /Volume/home
# 摸到用户数据),所以用 bind mount。
# ---------------------------------------------------------------------------
if ! mountpoint -q /home; then
    mount --bind /Volume/home /home
    keel_log "已把 /Volume/home 绑定到 /home"
fi

# ---------------------------------------------------------------------------
# /nix:同样必须是**真实挂载点** —— nix 硬性拒绝符号链接的 store 路径
#
# 装机后实测(2026-09,坑 #34):
#   error: the path '/nix' is a symlink; this is not allowed for the Nix store
#          and its parent directories
# 也不能改成"把 store 放到 /Volume/nix":store 里的二进制与脚本把 /nix/store/…
# 写死在 ELF interpreter 与 RPATH 里,位置搬不动。所以 /nix 是镜像里的真实空目录,
# 启动早期 bind 到 /Volume/nix(骨架里本来就有 store/ 与 var/nix/…)。
# 本单元排在 sysinit 之前,任何 nix 相关单元都在它后面,顺序上够用。
# ---------------------------------------------------------------------------
if ! mountpoint -q /nix; then
    if [ -d /nix ]; then
        install -d -m 0755 /Volume/nix
        mount --bind /Volume/nix /nix
        keel_log "已把 /Volume/nix 绑定到 /nix"
    else
        # 旧镜像里 /nix 是指向 /Volume/nix 的符号链接(根是只读的,这里改不了它),
        # nix 会拒绝这种 store 路径 —— 说清楚,别让人对着报错猜(坑 #34)
        keel_log "警告:/nix 不是目录(而是符号链接?)—— nix 会拒绝符号链接的 store 路径,"
        keel_log "      换到新槽或重装后会修复;临时办法见 docs/troubleshooting.md §4"
    fi
fi

# ---------------------------------------------------------------------------
# /etc:overlayfs(lower = 只读镜像,upper/work = /Volume)
#
# 为什么不是"把 /Volume/etc 直接 bind 过来":那是一次性快照,
# 新版本镜像里 /etc 的任何改进都会被旧副本永久遮蔽(AGENTS.md 不变量 5)。
# ---------------------------------------------------------------------------
if [ "$(findmnt -no FSTYPE /etc 2>/dev/null || true)" != overlay ]; then
    mount -t overlay overlay \
        -o "lowerdir=/etc,upperdir=/Volume/overlayfs/etc/upper,workdir=/Volume/overlayfs/etc/work" \
        /etc
    keel_log "已在 /etc 上挂载 overlayfs"
    # PID1 在启动时只读到过 lower 里的 unit 文件。不 reload 的话,
    # 只存在于 upper(/Volume)里的 unit 永远不会被加载(坑 #8)。
    systemctl daemon-reload || keel_log "daemon-reload 失败(已忽略)"
fi
