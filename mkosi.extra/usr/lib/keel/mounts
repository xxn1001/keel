#!/usr/bin/env bash
# keel 启动早期挂载:挂 /data、在 /etc 上挂 overlayfs、把 /home 与 /nix 绑到 /data 下
#
# 由 keel-mounts.service 调用,必须极早运行(见 AGENTS.md 不变量 1/2/5、
# 已知的坑 #8/#24,docs/architecture.md §4.1 §4.3)。
set -euo pipefail
. /usr/lib/keel/lib.sh

# ---------------------------------------------------------------------------
# /data:必须在这里挂 —— **不能**交给 kernel cmdline 的 systemd.mount-extra
#
# 曾经的写法是 cmdline 里 systemd.mount-extra=PARTLABEL=data:/data:ext4:rw,noatime,
# 真机(VM)实测会死锁,详见 docs/traps.md 坑 #24:
#   * 该 cmdline 在主系统里生成 data.mount 单元,它 Requires/After
#     dev-disk-by-partlabel-data.device —— 要等 udev 建出 by-partlabel 符号链接;
#   * 主系统 udev 要等 systemd-sysusers,而 sysusers 需要**可写的 /etc**;
#   * 可写的 /etc 是本脚本挂的 overlay(upper/work 在 /data 上)⇒ 回到第一点。
#   * 表现:systemd 破环时丢掉 local-fs-pre.target,udev 被推到 emergency 之后,
#     所有 by-partlabel 挂载 90s 超时 ⇒ local-fs.target 失败 ⇒ emergency mode。
# 所以改成自己挂,而且**不依赖 udev**:内核在 /sys 的 uevent 里直接给出 GPT 分区名
# (PARTNAME=)。blkid 只是兜底(它直接读文件系统超级块,同样不需要 udev)。
# 查找逻辑在 lib.sh 的 keel_part_dev()(os-install / os-rescue 也用同一份)。
# ---------------------------------------------------------------------------
if ! mountpoint -q /data; then
    dev=$(keel_part_dev data) || keel_die "找不到 PARTNAME=data / LABEL=data 的分区,无法挂载 /data。系统状态不可信,请用救援盘(os-rescue)检查分区表"
    install -d -m 0755 /data
    mount -t ext4 -o rw,noatime "$dev" /data
    keel_log "已把 $dev 挂到 /data"
fi

# ---------------------------------------------------------------------------
# ESP:由**我们自己**挂,不再交给 systemd-gpt-auto-generator(坑 #36)
#
# 装机后的系统上实测:ESP 压根没挂上,而 os-status 只看得到 lower 里那个空 /boot,
# 于是"看不到任何 UKI"、`上次启动结果: 无记录`;更糟的是 os-update 写新 UKI、
# `bootctl set-oneshot/set-default` 切槽、boot counting 改名全都在一个空目录上"成功"
# ⇒ A/B 更新与槽确认这条链整条是断的。
# gpt-auto 挂 ESP 的条件有好几条,而且**任何一条不满足都只是静默跳过**
# (fstab 里有 /boot 条目、/boot 不空、读不到 EFI 变量 LoaderDevicePartUUID …),
# 排查成本极高;我们要的东西很明确(一个可写的 vfat 挂在 /boot),那就自己挂。
#
# 幂等 + 绝不重复挂:先看挂载表里有没有"源设备 = PARTNAME=esp"的 vfat(可能是
# gpt-auto 之前挂的,比如挂在 /efi),有就用现成的 —— 同一块 vfat 挂两次没有好处。
# 挂载逻辑在 lib.sh 的 keel_esp_mount()(os-rescue --repair-boot 也调它)。
# ---------------------------------------------------------------------------
if esp_mnt=$(keel_esp_mount); then
    if [ "$esp_mnt" = "$KEEL_ESP_MOUNT" ]; then
        keel_log "已把 ESP(PARTNAME=esp)挂到 $esp_mnt(可写)"
    else
        keel_log "ESP 已经在 $esp_mnt(别人挂的,不重复挂)"
    fi
else
    # 不 die:没有 ESP 也能进系统(引导器是固件那侧的事)。但没有它,更新/切槽/确认
    # 全都做不了,所以必须**大声**说清楚,而不是让上层在空目录上继续"成功"。
    keel_log "警告:没找到/挂不上 PARTNAME=esp 的分区(或者 EFI 变量那侧不对)"
    keel_log "      ⇒ 这次启动里 os-update / bootctl 切槽 / keel-confirm 都不会生效;"
    keel_log "      用 os-status 看 ESP 一节,或在救援盘上跑 os-rescue --repair-boot"
fi

# ---------------------------------------------------------------------------
# 处理"恢复出厂 /etc"的请求(os-rescue --reset-etc 写下的标志)
#
# 必须在挂 overlay 之前做。旧的可写层整体改名保留成备份而不是删除 ——
# 那里面装着账号、SSH 主机密钥、machine-id、Wi-Fi 密码,直接删掉不可逆。
# ---------------------------------------------------------------------------
if [ -e /data/overlayfs/.reset-etc-requested ]; then
    ts=$(date +%Y%m%d-%H%M%S)
    bak="/data/overlayfs/etc.bak-$ts"
    keel_log "收到恢复出厂 /etc 的请求:旧的可写层备份到 $bak(不会删除)"
    mv /data/overlayfs/etc/upper "$bak"
    # workdir 里可能残留指向旧 upper 的条目,一并重建,否则 overlayfs 会拒绝挂载
    rm -rf /data/overlayfs/etc/work
    install -d -m 0755 /data/overlayfs/etc/upper /data/overlayfs/etc/work
    rm -f /data/overlayfs/.reset-etc-requested
    # 备份只留最近一份(决策 D23)。旧备份里同样是"账号 + SSH 主机密钥 + machine-id",
    # 留着既是隐私负担也是磁盘负担;真要找回上一份,一份就够。
    # `ls -1dt` 按时间倒序,`tail -n +2` 跳过最新那份;xargs -r 保证没有旧备份时不报错。
    # shellcheck disable=SC2012  # 名字都是我们自己生成的时间戳,没有怪字符
    ls -1dt /data/overlayfs/etc.bak-* 2>/dev/null | tail -n +2 | xargs -r rm -rf
    kept=$(ls -1dt /data/overlayfs/etc.bak-* 2>/dev/null | head -n1) || kept=""
    if [ -n "$kept" ]; then
        keel_log "保留的 /etc 备份:$kept(更早的已清理)"
    fi
fi

# ---------------------------------------------------------------------------
# /home:必须是**真实挂载点**
#
# 符号链接会让 ProtectHome= 之类的沙箱设置失效(服务仍能通过 /data/home
# 摸到用户数据),所以用 bind mount。
# ---------------------------------------------------------------------------
if ! mountpoint -q /home; then
    mount --bind /data/home /home
    keel_log "已把 /data/home 绑定到 /home"
fi

# ---------------------------------------------------------------------------
# /nix:同样必须是**真实挂载点** —— nix 硬性拒绝符号链接的 store 路径
#
# 装机后实测(2026-09,坑 #34):
#   error: the path '/nix' is a symlink; this is not allowed for the Nix store
#          and its parent directories
# 也不能改成"把 store 放到 /data/nix":store 里的二进制与脚本把 /nix/store/…
# 写死在 ELF interpreter 与 RPATH 里,位置搬不动。所以 /nix 是镜像里的真实空目录,
# 启动早期 bind 到 /data/nix(骨架里本来就有 store/ 与 var/nix/…)。
# 本单元排在 sysinit 之前,任何 nix 相关单元都在它后面,顺序上够用。
# ---------------------------------------------------------------------------
if ! mountpoint -q /nix; then
    if [ -d /nix ]; then
        install -d -m 0755 /data/nix
        mount --bind /data/nix /nix
        keel_log "已把 /data/nix 绑定到 /nix"
    else
        # 旧镜像里 /nix 是指向 /data/nix 的符号链接(根是只读的,这里改不了它),
        # nix 会拒绝这种 store 路径 —— 说清楚,别让人对着报错猜(坑 #34)
        keel_log "警告:/nix 不是目录(而是符号链接?)—— nix 会拒绝符号链接的 store 路径,"
        keel_log "      换到新槽或重装后会修复;临时办法见 docs/troubleshooting.md §4"
    fi
fi

# ---------------------------------------------------------------------------
# /etc:overlayfs(lower = 只读镜像,upper/work = /data)
#
# 为什么不是"把 /data/etc 直接 bind 过来":那是一次性快照,
# 新版本镜像里 /etc 的任何改进都会被旧副本永久遮蔽(AGENTS.md 不变量 5)。
# ---------------------------------------------------------------------------
if [ "$(findmnt -no FSTYPE /etc 2>/dev/null || true)" != overlay ]; then
    mount -t overlay overlay \
        -o "lowerdir=/etc,upperdir=/data/overlayfs/etc/upper,workdir=/data/overlayfs/etc/work" \
        /etc
    keel_log "已在 /etc 上挂载 overlayfs"
    # PID1 在启动时只读到过 lower 里的 unit 文件。不 reload 的话,
    # 只存在于 upper(/data)里的 unit 永远不会被加载(坑 #8)。
    systemctl daemon-reload || keel_log "daemon-reload 失败(已忽略)"
fi

# ---------------------------------------------------------------------------
# /etc/machine-id:把 mkosi 写的占位符 "uninitialized" 变成真正的 ID
#
# 不做这一件事,整个 networkd 的 DHCP 就是死的 —— 这就是坑 #29("Failed to configure
# DHCPv4 client: Package not installed")的根因:
#
#   * mkosi 在镜像里放的是 `uninitialized`(它的占位符,表示"首启再生成");
#   * PID1 做 machine-id 初始化时**我们的 overlay 还没挂**(那是本脚本干的),
#     它看到根是只读的,就判定"只能 transient":把真 ID 写到 /run/machine-id,
#     再 bind mount 到 /etc/machine-id 上;
#   * 紧接着我们把 overlay 挂到 /etc —— **那个 bind mount 被整个盖住**
#     (overlay 的 lower 是"旧的 /etc",看不到挂在里面的子挂载)
#     ⇒ /etc/machine-id 永远是 lower 里那句 "uninitialized";
#   * 于是 `sd_id128_get_machine()` 返回 -ENOPKG(`id128_read` 对 "uninitialized"
#     这个内容专门返回 ENOPKG,不是 ENOENT),networkd 生成 DUID(默认
#     `DUIDType=uuid`,要 machine-id)时拿到它 ⇒ 每个启动都失败,报文
#     "Package not installed" 就是 ENOPKG 的 strerror。
#   * `systemd-machine-id-commit.service` 也救不了:它要求 /etc/machine-id 是**挂载点**,
#     而那个 bind mount 已经被 overlay 盖掉了,条件永远不成立。
#
# 影响面不止 DHCP:IPv6 稳定隐私地址、resolved 的 DNSSEC 密钥、任何 `%m` 展开
# 都要 machine-id(顺手也解释了为什么这些功能一直"没反应")。
#
# ⚠ 第一版这里写的是 `systemd-machine-id-setup`,**VM 实测完全无效**(日志打出
#   `已生成 machine-id(uninitialized)`,退出码还是 0)。原因在它的 main() 里:
#       } else if (id128_get_machine(arg_root, NULL) == -ENOPKG) {
#               if (arg_print) puts("uninitialized");     // ← 什么都不做就返回 0
#       } else { ... machine_id_setup(...) ... }
#   也就是说**内容恰好是 "uninitialized" 时它故意不动**(那是"首启标记",留给 PID1 的
#   transient 机制),而且**退出码 0 什么也证明不了**。所以这里自己动手:
#
#   ① 首选:把 PID1 本次启动**已经在用**的那个 ID(/run/machine-id)写进 /etc ——
#      它就是 PID1 内存里那个 ID(首启 PID1 把真 ID 写这儿、再 bind 到 /etc/machine-id),
#      固化它 ⇒ 本次启动前后一致。
#   ② 退路:/run/machine-id 不可用时,先把文件清空再交给 systemd-machine-id-setup ——
#      空文件不是 ENOPKG,它会走正常的 machine_id_setup() 生成一个随机 ID 写进去。
#
# 写的时候 /etc 已经是 overlay ⇒ 内容落在 upper ⇒ 持久化在 /data 上,换槽/更新都不丢。
# 每一步都回读校验,失败就大声报(这个文件无效会让 DHCP/IPv6/DNSSEC 一起静默失效)。
#
# 已知的残留不一致(不影响功能,记在这里免得以后有人当成 bug):
# 从第二次启动起,PID1 读到的仍是**只读 lower** 里那句 "uninitialized" ⇒ 它每次启动都会
# 另生成一个 transient ID 放在 /run/machine-id(PID1 内存里的 ID ≠ /etc/machine-id)。
# 真正读文件的功能(networkd、resolved、journald、tmpfiles…)拿到的都是我们固化的那个,
# 稳定的;只有 PID1 自己展开 `%m` 时用的是它内存里那个。要彻底消除,只有两条路:
# 把 /etc overlay 提前到 initrd 里挂(PID1 一开始就读到持久化的 ID),
# 或者 cmdline 里加 `systemd.machine_id=firmware`(用硬件 UUID,代价是依赖 DMI 可靠)。
# ---------------------------------------------------------------------------
if ! keel_machine_id_valid /etc/machine-id; then
    # ① PID1 本次启动的 ID(它是首启时写到 /run 的,不是垃圾文件:/run 是 tmpfs)
    if keel_machine_id_valid /run/machine-id && cat /run/machine-id >/etc/machine-id 2>/dev/null; then
        keel_log "已固化 machine-id(取自 PID1 本次启动使用的 ID)"
    else
        # ② 清空 + 让官方工具生成(空文件时它才会真的干活)
        : >/etc/machine-id 2>/dev/null || true
        systemd-machine-id-setup >/dev/null 2>&1 || true
    fi
    chmod 0444 /etc/machine-id 2>/dev/null || true

    if keel_machine_id_valid /etc/machine-id; then
        keel_log "machine-id = $(cat /etc/machine-id)"
    else
        keel_log "警告:/etc/machine-id 仍然不是有效 ID(内容:$(cat /etc/machine-id 2>/dev/null))——"
        keel_log "      networkd 的 DHCP、IPv6 稳定地址、resolved 的 DNSSEC 都会拿到 -ENOPKG(坑 #29);"
        keel_log "      手动修:systemd-machine-id-setup(先清空该文件),然后 systemctl restart systemd-networkd"
    fi
fi
