#!/bin/bash
# keel 首启与自愈:幂等,每次启动都跑一遍
#
# 由 keel-firstboot.service 调用。设计原则:每一步都能安全重复执行,
# 任何一步失败都不应该让系统起不来(所以大部分失败只记日志)。
set -euo pipefail
. /usr/lib/keel/lib.sh

# ---------------------------------------------------------------------------
# 1) /data 骨架自愈
#
# cp -a -n(no-clobber):只补缺失的,绝不覆盖已有内容。
# 这同时是"手贱清空了 data"和"忘了重建 dbus machine-id 链接"的修复入口
# (docs/traps.md 坑 #3)。
# ---------------------------------------------------------------------------
if [ -d /usr/share/keel/data-skeleton ]; then
    cp -a -n /usr/share/keel/data-skeleton/. /data/ || true
fi
[ -e "$KEEL_SCHEMA_FILE" ] || echo 1 >"$KEEL_SCHEMA_FILE"

# ---------------------------------------------------------------------------
# 2) SSH 主机密钥
#
# 镜像里刻意不含主机密钥(否则所有装机实例共用同一套,见 mkosi.conf.d/20-packages.conf
# 里的 RemoveFiles)。这里按需生成,写进 /etc overlay 的 upper ⇒ 换槽和更新都不会丢。
# ---------------------------------------------------------------------------
if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
    if ssh-keygen -A >/dev/null 2>&1; then
        keel_log "已生成 SSH 主机密钥(每台机器唯一)"
    fi
fi

# ---------------------------------------------------------------------------
# 3) NVRAM 启动项(只做一次)
#
# 镜像里的 ESP 已经带 fallback 路径 EFI/BOOT/BOOTX64.EFI,所以即使这一步失败、
# 或者固件后来清空了 NVRAM,机器仍然能启动(systemd-boot 会自己去 /EFI/Linux 找 UKI)。
# 只做一次是为了避免每次启动都往 NVRAM 写东西。
# ---------------------------------------------------------------------------
if [ ! -e /data/keel/.boot-entry-created ]; then
    # ESP 通常已由 keel-mounts 挂好;这里再试一次是首启自愈的入口(坑 #36)
    esp_mnt=$(keel_esp_mount 2>/dev/null) || esp_mnt=""
    if [ -z "$esp_mnt" ]; then
        keel_log "警告:ESP 没挂上,bootctl install 会失败 —— 不影响本次启动(镜像 ESP 里有 fallback 路径),"
        keel_log "      但 NVRAM 里不会有 keel 的启动项;修好 ESP 后跑 os-rescue --repair-boot"
    fi
    if bootctl install >/dev/null 2>&1; then
        : >/data/keel/.boot-entry-created
        keel_log "已在 ESP 上安装引导器并登记 NVRAM 启动项"
    else
        keel_log "bootctl install 失败(稍后可以手动跑 os-rescue --repair-boot)"
    fi
fi

# ---------------------------------------------------------------------------
# 4) 状态文件初始化
# ---------------------------------------------------------------------------
if [ -z "$(keel_state_get running_slot)" ]; then
    keel_state_set running_slot "$(keel_current_slot)"
fi

# ---------------------------------------------------------------------------
# 5) 把 data 分区扩到整盘(分区 + 文件系统,**两步都要**)
#
# 为什么要两步:systemd-repart 只扩**分区**,它从不改动已存在分区的文件系统
# (源码里 context_mkfs() 对已存在的分区直接 continue)。repart 定义里的
# GrowFileSystem= 只是打一个 GPT 标志位,而那个标志只被 systemd-gpt-auto-generator
# 消费 —— 我们的 /data 是 keel-mounts 自己用 `mount` 挂的(不变量 2),
# 根本不过 gpt-auto-generator。所以文件系统必须自己扩:先试 systemd-growfs,
# 失败就退回 resize2fs(坑 #42)。
# (docs/traps.md 坑 #14;真机首启后请用 df -h /data 复核。)
#
# 两步都幂等:分区表符合定义时 repart 什么都不做;文件系统到顶时 resize2fs 返回 0。
# 所以每次启动跑一遍是安全的,这也是"把镜像 dd 到更大的盘之后"的自愈入口。
# ---------------------------------------------------------------------------
vol=$(readlink -f /dev/disk/by-partlabel/data 2>/dev/null || true)
if [ -n "$vol" ] && [ -b "$vol" ]; then
    pk=$(lsblk -ndo PKNAME "$vol" 2>/dev/null | head -n1 || true)
    if [ -n "$pk" ] && [ -b "/dev/$pk" ]; then
        if ! systemd-repart --dry-run=no --definitions=/usr/lib/keel/repart.d "/dev/$pk" >/dev/null 2>&1; then
            keel_log "data 分区扩容失败(稍后可以手动跑 os-rescue --grow-data)"
        fi
    fi
    # 分区弄好之后再把文件系统顶满。
    #
    # 为什么**不用** systemd-growfs 当唯一手段(2026-09,用 40G 假盘复现,坑 #42):
    # 它要求挂载点背后有一个 **systemd .mount 单元**,而我们的 /data 是 keel-mounts
    # 自己用 mount(8) 挂的(不变量 2)⇒ 它直接失败,而原来的写法把输出 `>/dev/null 2>&1`
    # 吞掉了 ⇒ 现象是"分区扩到 27G 了、文件系统还是 974M",日志里只有一句看不出原因的
    # "没能扩容"。现在:先试它、**把它的错误原样打出来**,失败就退回 resize2fs
    # (ext4 的在线扩容,mounted 状态下也能扩;已经到顶时它返回 0)。
    if ! gf_out=$(systemd-growfs /data 2>&1); then
        keel_log "systemd-growfs /data 失败:$gf_out"
        keel_log "改用 resize2fs 直接扩 /data(ext4 在线扩容;坑 #42)"
        if rs_out=$(resize2fs "$vol" 2>&1); then
            keel_log "resize2fs 成功:$(printf '%s' "$rs_out" | tr '\n' ' ')"
        else
            keel_log "错误:resize2fs 也失败了:$rs_out(手动入口:os-rescue --grow-data)"
        fi
    fi
    # 每次都把"分区多大 / 文件系统多大"记下来 —— 这两个数字不一致就是坑 #42 复发
    part_bytes=$(blockdev --getsize64 "$vol" 2>/dev/null) || part_bytes=""
    fs_bytes=$(df -P -B1 /data 2>/dev/null | awk 'NR==2{print $2}') || fs_bytes=""
    keel_log "data 尺寸:分区 ${part_bytes:-未知} 字节 / 文件系统 ${fs_bytes:-未知} 字节"
    if [ -n "$part_bytes" ] && [ -n "$fs_bytes" ] &&
       [ "$part_bytes" -gt "$fs_bytes" ] 2>/dev/null; then
        keel_log "警告:data 分区比文件系统大 $(( (part_bytes - fs_bytes) / 1048576 )) MiB —— 文件系统没扩到位(坑 #42)"
    fi
fi

# ---------------------------------------------------------------------------
# 6) 应急空间(reserve,决策 D23)
#
# 在 /data 上占住 256 MiB,等它**真的**快写满时由 keel-data-guard 交还 ——
# 换一次"还能把 machine-id / SSH 主机密钥写下去"的机会。
# 为什么值得:坑 #37 已经证明 /data 写满 = /etc 也写不进去(overlay 的 upper 在同一个
# 文件系统上),而 /etc/machine-id 写不下去就等于 DHCP/IPv6/DNSSEC 一起坏掉(坑 #29)。
#
# 幂等:每次启动检查,存在就不动;被 guard 用掉之后,等空间恢复健康会在这里重建
# (/data/keel/reserve-consumed 保留"曾经用过"的记录,由 os-status 呈现)。
# 保守:小文件系统(镜像/实验环境)不创建 —— 那里本来就没什么值得保护的状态。
# ---------------------------------------------------------------------------
RESERVE="$KEEL_STATE_DIR/.reserve"
if [ ! -e "$RESERVE" ]; then
    read -r dsize davail < <(df -P -B1 /data 2>/dev/null | awk 'NR==2{print $2, $4}')
    case "${dsize:-}" in ''|*[!0-9]*) dsize=0 ;; esac
    case "${davail:-}" in ''|*[!0-9]*) davail=0 ;; esac
    if [ "$dsize" -ge $((4 * 1024 * 1024 * 1024)) ] && [ "$davail" -ge $((1024 * 1024 * 1024)) ]; then
        if fallocate -l 256M "$RESERVE" 2>/dev/null ||
           dd if=/dev/zero of="$RESERVE" bs=1M count=256 status=none 2>/dev/null; then
            chmod 0600 "$RESERVE"
            keel_log "已预留 256 MiB 应急空间(/data/keel/.reserve;写满时由 keel-data-guard 交还)"
        else
            rm -f "$RESERVE"
            keel_log "注意:应急空间没能创建(可用空间不足?)"
        fi
    else
        keel_log "跳过应急空间:/data 只有 $((dsize / 1048576)) MiB 或可用空间不足(小分区/实验环境,预期行为)"
    fi
fi
