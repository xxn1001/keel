#!/bin/bash
# keel-check —— 「装好之后,这台机器到底行不行」的体检脚本
#
# 在哪跑:装好的系统里(libvirt 虚拟机、真机都一样)。admin 家目录里有一个同名入口:
#     sudo ~/keel-check
# 也可以直接跑镜像里那份(升级系统后它总是最新的):
#     sudo /usr/share/keel/keel-check
#
# 输出:逐项 ✓ / ✗ / ! ;退出码 0 = 没有 ✗,1 = 有 ✗。
# 非 root 也能跑,只是涉及 /etc/shadow 的账号检查会跳过。
#
# 设计约束(和 os-status 一样):**绝不因为读不到某个文件就崩** ——
# 半坏的机器正是最需要它的时候。所以每项都自己兜底,输出"未知"而不是报错退出。
set -uo pipefail
# shellcheck source=/usr/lib/keel/lib.sh
# shellcheck disable=SC1091
. /usr/lib/keel/lib.sh 2>/dev/null || true

pass=0; fail=0; skip=0; warn=0
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; pass=$((pass+1)); }
no()   { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=$((fail+1)); }
sk()   { printf '  \033[33m-\033[0m %s\n' "$*"; skip=$((skip+1)); }
wn()   { printf '  \033[33m!\033[0m %s\n' "$*"; warn=$((warn+1)); }
head1(){ printf '\n\033[1m%s\033[0m\n' "$*"; }
isroot() { [ "$(id -u)" = 0 ]; }
have() { command -v "$1" >/dev/null 2>&1; }
rd()   { cat "$1" 2>/dev/null || true; }

NIX_TEST=0
for a in "$@"; do
    case "$a" in
        --nix-install-test) NIX_TEST=1 ;;
        -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'keel-check: 不认识的参数 %s(只支持 --nix-install-test)\n' "$a" >&2; exit 2 ;;
    esac
done

printf '\033[1mkeel-check\033[0m —— 装机后的体检(%s)\n' "$(date -Is 2>/dev/null || date)"

# ---------------------------------------------------------------------------
head1 "1. 这台机器是什么"
# ---------------------------------------------------------------------------
printf '  %-14s %s\n' "hostname" "$(hostname 2>/dev/null || echo 未知)"
printf '  %-14s %s\n' "系统版本" "$(keel_version 2>/dev/null || echo 未知)(/usr/lib/os-release 的 IMAGE_VERSION)"
printf '  %-14s %s\n' "当前槽" "$(keel_current_slot 2>/dev/null || echo 未知)"
printf '  %-14s %s\n' "内核" "$(uname -r)"
printf '  %-14s %s\n' "启动方式" "$([ -d /sys/firmware/efi ] && echo "UEFI(EFI 变量可写:$([ -w /sys/firmware/efi/efivars ] && echo 是 || echo 否))" || echo "**不是 UEFI**")"
printf '  %-14s %s\n' "运行时长" "$(uptime -p 2>/dev/null || cut -d' ' -f1 /proc/uptime)"

if [ "$(hostname 2>/dev/null)" = keel ]; then ok "hostname 是 keel"; else wn "hostname 不是 keel(决策 D22 定的默认值)"; fi
if [ -d /sys/firmware/efi ]; then ok "UEFI 启动(A/B 的槽切换与 boot counting 依赖 EFI 变量)"; else no "不是 UEFI 启动 —— 引导链的前提不成立"; fi

# ---------------------------------------------------------------------------
head1 "2. 挂载与布局(不变量 1/2/5)"
# ---------------------------------------------------------------------------
root_opts=$(findmnt -no OPTIONS / 2>/dev/null || true)
if [ -z "$root_opts" ]; then
    wn "读不到根分区的挂载选项"
elif printf '%s\n' "$root_opts" | tr ',' '\n' | grep -qx ro; then
    ok "根分区是只读挂载($root_opts)"
else
    no "根分区**不是**只读:$(findmnt -no SOURCE,OPTIONS / 2>/dev/null)"
fi
for pair in "/var:/data/var" "/root:/data/home/root"; do
    l=${pair%%:*}; t=${pair#*:}
    if [ -L "$l" ] && [ "$(readlink "$l")" = "$t" ]; then ok "$l → $t(符号链接)"; else no "$l 不是指向 $t 的符号链接(现在:$(readlink "$l" 2>/dev/null || echo 不是链接))"; fi
done
for m in /home /nix; do
    src=$(findmnt -no SOURCE "$m" 2>/dev/null || true)
    if [ -L "$m" ]; then no "$m 是符号链接 —— 必须是真实挂载点(不变量 1)"
    elif [ -n "$src" ]; then ok "$m 是真挂载点(绑定自 $src)"
    else no "$m 没有挂载(现在只是个空目录)"; fi
done
etc_fs=$(findmnt -no FSTYPE /etc 2>/dev/null || true)
if [ "$etc_fs" = overlay ]; then
    up=$(findmnt -no OPTIONS /etc 2>/dev/null | tr ',' '\n' | sed -n 's/^upperdir=//p')
    ok "/etc 是 overlayfs(upper=$up)"
else
    no "/etc 不是 overlayfs(现在:$etc_fs)—— 配置改动不会持久化"
fi
esp=$(findmnt -no SOURCE,TARGET,FSTYPE /boot 2>/dev/null || true)
if [ -n "$esp" ]; then ok "ESP 挂在 /boot($esp)"; else no "ESP 没挂在 /boot ⇒ 槽切换/UKI 更新都会失效(坑 #36)"; fi

# ---------------------------------------------------------------------------
head1 "3. /data:骨架、版本、容量"
# ---------------------------------------------------------------------------
data_src=$(findmnt -no SOURCE,FSTYPE /data 2>/dev/null || true)
if [ -n "$data_src" ]; then ok "/data 已挂载($data_src)"; else no "/data 没挂上 —— 后面所有状态都是假的(见 troubleshooting §3)"; fi
missing=""
for d in keel var overlayfs home nix ota; do [ -e "/data/$d" ] || missing="$missing $d"; done
if [ -z "$missing" ]; then ok "/data 骨架完整(keel var overlayfs home nix ota)"; else no "/data 骨架缺:$missing(修复:sudo os-rescue --init-data)"; fi
schema=$(rd /data/keel/schema-version)
printf '  %-14s %s\n' "布局版本" "${schema:-未知}"
read -r dsize davail < <(df -P -B1 /data 2>/dev/null | awk 'NR==2{print $2, $4}')
if [ -n "${dsize:-}" ]; then
    dsize_h=$(awk -v b="$dsize" 'BEGIN{printf "%.1f GiB", b/1073741824}')
    davail_h=$(awk -v b="$davail" 'BEGIN{printf "%.1f GiB", b/1073741824}')
    dpct=$(awk -v a="$davail" -v b="$dsize" 'BEGIN{ if (b > 0) printf "%.0f", a*100/b; else printf "?" }')
    printf '  %-14s %s / 可用 %s(%s%%)\n' "/data 容量" "$dsize_h" "$davail_h" "$dpct"
    big=$((4 * 1024 * 1024 * 1024))
    if [ "${dsize:-0}" -ge "$big" ]; then
        ok "/data 不小于 4 GiB(装到整盘的机器应该远大于此)"
    else
        wn "/data 只有 $((dsize / 1048576)) MiB —— 在 live 镜像里跑时这是预期的;真机装完应该扩到整盘(不变量 14)"
    fi
    # ext4 的元数据让 df 看到的 Size 天然比设备小 1~2%,所以比"设备大小"要放宽 5%
    ddev=$(keel_part_dev data 2>/dev/null || true)
    if [ -n "$ddev" ]; then
        dbytes=$(blockdev --getsize64 "$ddev" 2>/dev/null || echo 0)
        if [ "${dbytes:-0}" -gt 0 ] && [ "${dsize:-0}" -lt $((dbytes - dbytes / 20)) ]; then
            no "data 分区 $((dbytes / 1048576)) MiB,而文件系统只有 $((dsize / 1048576)) MiB —— 文件系统没扩到位(坑 #42;修复:sudo os-rescue --grow-data)"
        else
            ok "data 分区与文件系统尺寸一致(分区 $((dbytes / 1048576)) MiB)"
        fi
    fi
fi
[ -e /data/keel/.reserve ] && ok "应急空间在(/data/keel/.reserve,256 MiB)" || wn "没有应急空间(小分区不建是正常的;真机应该建)"
gv=$(sed -n 's/^verdict=//p' /data/keel/data-guard.state 2>/dev/null | tail -1)
[ -n "$gv" ] && printf '  %-14s %s\n' "空间看门人" "$gv(见 /data/keel/data-guard.state)" || wn "看门人还没写过结论(keel-data-guard.timer 跑过吗)"
if [ -n "$(swapon --show 2>/dev/null)" ]; then ok "swap 已启用:$(( $(swapon --show=SIZE --noheadings --bytes 2>/dev/null | head -1 || echo 0) / 1048576 )) MiB"; else wn "没有 swap(空间紧张时不建是正常的,见决策 D9)"; fi

# ---------------------------------------------------------------------------
head1 "4. 账号与 SSH(决策 D21)"
# ---------------------------------------------------------------------------
idout=$(id admin 2>/dev/null || true)
if [ -n "$idout" ]; then
    ok "admin 存在:$idout"
    case "$idout" in *"(sudo)"*) ok "admin 在 sudo 组" ;; *) no "admin 不在 sudo 组 ⇒ 没法提权" ;; esac
else
    no "admin 账号不存在"
fi
if isroot; then
    a_hash=$(awk -F: '$1=="admin"{print $2}' /etc/shadow 2>/dev/null || true)
    r_hash=$(awk -F: '$1=="root"{print $2}' /etc/shadow 2>/dev/null || true)
    case "$a_hash" in
        \$*) ok "admin 有密码(初值是 -p / mkosi.rootpw 给的那个)" ;;
        "")  wn "读不到 admin 的 shadow 字段" ;;
        *)   wn "admin 没有密码(shadow '$a_hash')⇒ 只能靠 SSH 公钥登录" ;;
    esac
    case "$r_hash" in
        '!'*|'*'*) ok "root 已锁定(shadow '$r_hash')" ;;
        \$*) no "**root 没锁定** —— 不该出现,见决策 D21" ;;
        *)   wn "root 状态未知(shadow '$r_hash')" ;;
    esac
else
    sk "账号密码/root 锁定检查需要 root(用 sudo 跑能看)"
fi
if [ -r /etc/sudoers.d/10-keel-admin ]; then
    ok "sudoers 规则在(/etc/sudoers.d/10-keel-admin,需要密码)"
else
    no "缺 /etc/sudoers.d/10-keel-admin ⇒ admin 无法 sudo"
fi
dropin=$(grep -h '^PermitRootLogin' /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1)
[ "$dropin" = "PermitRootLogin no" ] && ok "sshd:PermitRootLogin no" || wn "sshd 的 PermitRootLogin 不是 no(现在:'${dropin:-未设置}')"
if systemctl is-active --quiet ssh.service 2>/dev/null || systemctl is-active --quiet ssh.socket 2>/dev/null; then
    ok "sshd 在跑"
else
    no "sshd 没在跑 ⇒ 装好的机器只能靠控制台进去"
fi
keys=$(ls /data/home/admin/.ssh/authorized_keys 2>/dev/null || true)
[ -n "$keys" ] && ok "admin 有 SSH 公钥($(wc -l <"$keys" 2>/dev/null || echo '?') 行)" || wn "admin 家目录里没有 authorized_keys(只能靠密码登录)"

# ---------------------------------------------------------------------------
head1 "5. 网络(networkd + resolved,决策 D15)"
# ---------------------------------------------------------------------------
iface=""
for _n in /sys/class/net/*; do
    _b=${_n##*/}
    case "$_b" in en*|eth*) iface=$_b; break ;; esac
done
printf '  %-14s %s\n' "接口" "${iface:-无}"
addr=$(ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4}' | head -1 || true)
if [ -n "$addr" ]; then ok "$iface 拿到 IPv4:$addr"; else no "$iface 没有 IPv4 地址(DHCP 没成功?看 journalctl -u systemd-networkd)"; fi
op=$(networkctl list --no-pager --no-legend 2>/dev/null | awk -v i="$iface" '$2==i{print $4}' || true)
[ "$op" = routable ] && ok "链路状态 routable" || wn "链路状态:${op:-未知}(可能是没插网线/没上游 DHCP)"
gw=$(ip -4 route show default 2>/dev/null | awk '{print $3}' | head -1 || true)
[ -n "$gw" ] && ok "默认路由:$gw" || wn "没有默认路由(离线机器可以忽略)"
dns=$(resolvectl status --no-pager 2>/dev/null | awk '/Current DNS Server:|DNS Servers:/{sub(/^[ \t]+/,""); print $0}' | head -1 || true)
[ -n "$dns" ] && ok "DNS:$dns" || wn "没有 DNS(离线可以忽略)"
systemctl is-active --quiet systemd-networkd && ok "systemd-networkd 在跑" || no "systemd-networkd 没在跑"
systemctl is-active --quiet systemd-resolved && ok "systemd-resolved 在跑" || no "systemd-resolved 没在跑"
[ -L /etc/resolv.conf ] && [ "$(readlink /etc/resolv.conf)" = /run/systemd/resolve/stub-resolv.conf ] \
    && ok "/etc/resolv.conf 指向 resolved 的 stub" || wn "/etc/resolv.conf 不是 resolved 的 stub(现在:$(readlink /etc/resolv.conf 2>/dev/null || echo 普通文件))"

# ---------------------------------------------------------------------------
head1 "6. 服务健康与失败单元"
# ---------------------------------------------------------------------------
failed=$(systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l)
if [ "${failed:-1}" -eq 0 ]; then ok "systemctl --failed 为空"; else no "有 $failed 个失败单元:$(systemctl --failed --no-legend --no-pager 2>/dev/null | awk '{print $1}' | tr '\n' ' ')"; fi
for u in keel-mounts.service keel-firstboot.service keel-confirm.service ssh.service systemd-networkd.service systemd-resolved.service systemd-timesyncd.service nix-daemon.service; do
    if ! systemctl list-unit-files "$u" >/dev/null 2>&1; then sk "$u 不存在(这个变体里没有?)"; continue; fi
    st=$(systemctl is-active "$u" 2>/dev/null || true)
    [ "$st" = active ] && ok "$u active" || wn "$u 状态:$st"
done
if systemctl is-enabled --quiet keel-boot-failed-reboot.service 2>/dev/null; then
    ok "启动失败看门狗已启用(emergency 时 60 秒后自动回退,决策 D26)"
else
    wn "keel-boot-failed-reboot 没启用 ⇒ 进 emergency 时机器会停在提示符前"
fi

# ---------------------------------------------------------------------------
head1 "7. 引导链与更新状态"
# ---------------------------------------------------------------------------
if [ -d "$KEEL_UKI_DIR" ]; then
    # shellcheck disable=SC2012  # 这里就是给人看的清单
    n=$(ls -1 "$KEEL_UKI_DIR"/*.efi 2>/dev/null | wc -l)
    ok "ESP 上有 $n 个 UKI 条目"
    ls -1 "$KEEL_UKI_DIR" 2>/dev/null | sed 's/^/      /'
    bad=$(ls -1 "$KEEL_UKI_DIR"/*.failed 2>/dev/null | wc -l)
    [ "${bad:-0}" -gt 0 ] && wn "有 $bad 个 .failed 条目(曾经有个槽起不来,看 os-status 的「上次启动结果」)" || true
else
    no "看不到 $KEEL_UKI_DIR(ESP 没挂上?)"
fi
for f in a b; do
    dev="/dev/disk/by-partlabel/root-$f"
    if [ -b "$dev" ]; then
        printf '  %-14s %s\n' "槽 $f 分区" "$(lsblk -dno SIZE "$dev" 2>/dev/null || echo '?')($dev)"
    else
        wn "找不到槽 $f 的分区($dev)"
    fi
done
printf '  %-14s 当前 %s / 上次结果 %s\n' "更新状态" "$(sed -n 's/^pending_slot=//p' /data/keel/state 2>/dev/null | tail -1 || true)" "$(sed -n 's/^last_result=//p' /data/keel/state 2>/dev/null | tail -1 || true)"
last=$(sed -n 's/^last_result=//p' /data/keel/state 2>/dev/null | tail -1 || true)
case "$last" in
    success) ok "上次启动结果:success" ;;
    failed)  wn "上次启动结果:failed(曾经回滚过;想清掉就再走一次成功的更新)" ;;
    "")      wn "还没有启动结果记录(keel-confirm 没跑过?见坑 #41)" ;;
    *)       printf '  %-14s %s\n' "上次启动结果" "$last" ;;
esac
printf '  %-14s %s\n' "更新源" "$(keel_conf UPDATE_SOURCE "" 2>/dev/null || echo '未配置')"

# ---------------------------------------------------------------------------
head1 "8. 硬件、固件与兜底机制"
# ---------------------------------------------------------------------------
mc=$(dmesg 2>/dev/null | grep -i -m1 'microcode' || true)
if [ -n "$mc" ]; then ok "微码:$mc"; else wn "dmesg 里没有微码相关行(可能是内核没打印;不一定是问题)"; fi
if [ -e /dev/tpm0 ] || [ -e /dev/tpmrm0 ]; then ok "TPM 存在($(ls /dev/tpm* 2>/dev/null | tr '\n' ' '))"; else wn "没有 TPM(v1 不需要它;pcrlock 已按决策 D20 关掉)"; fi
wd=$(ls /dev/watchdog* 2>/dev/null | tr '\n' ' ')
rw=$(systemctl show -p RuntimeWatchdogUSec --value 2>/dev/null || true)
if [ -n "$rw" ] && [ "$rw" != "0" ]; then ok "运行时看门狗已武装($rw;$wd)(决策 D25)"; else no "运行时看门狗**没武装**(冻住时没人复位;决策 D25)"; fi
if grep -qs '^panic=-1' /proc/cmdline; then ok "cmdline 有 panic=-1(panic 会立即重启,决策 D24)"; else no "cmdline 里没有 panic=-1 ⇒ panic 会停在黑屏"; fi
if grep -q 'console=ttyS0' /proc/cmdline; then ok "串口控制台已启用(服务器带外管理用)"; else wn "cmdline 里没有 console=ttyS0(服务器的串口/带外管理看不到日志)"; fi
[ -e /run/keel/boot-complete ] && ok "本次启动已到过 boot-complete(看门狗不会误重启)" || wn "本次启动还没有 boot-complete 标记(如果 keel-confirm 没跑,恢复时要小心)"

# ---------------------------------------------------------------------------
head1 "9. nix(用户态在自己手里,不变量 7)"
# ---------------------------------------------------------------------------
if have nix; then ok "nix 命令在:$(nix --version 2>/dev/null | head -1)"; else no "找不到 nix 命令(基底里应该有 nix-bin)"; fi
if [ -d /nix ] && [ ! -L /nix ]; then ok "/nix 是真目录(不能是符号链接,坑 #34)"; else no "/nix 不是真目录 ⇒ nix 会拒绝工作"; fi
findmnt -no SOURCE /nix >/dev/null 2>&1 && ok "/nix 已挂载(绑定自 $(findmnt -no SOURCE /nix))" || no "/nix 没挂上"
if [ -w /nix/store ] || [ "$(stat -c %U /nix/store 2>/dev/null)" = root ]; then ok "/nix/store 存在且可写(当前用户 $(id -un) 通过 sudo 使用)"; else wn "/nix/store 可能不可写"; fi
if [ "$NIX_TEST" = 1 ]; then
    if have nix-shell; then
        if nix-shell -p fastfetch --run 'fastfetch --version' >/dev/null 2>&1; then ok "nix-shell -p fastfetch 可用(真的装了包并跑起来)"; else no "nix-shell -p fastfetch 失败(联网了吗?看 /data/nix 的空间)"; fi
    else
        wn "没有 nix-shell(只想验证 store,不影响)"
    fi
else
    sk "没有做「真装一个包」的验证(要联网、要时间);想跑就加 --nix-install-test"
fi

# ---------------------------------------------------------------------------
head1 "汇总"
# ---------------------------------------------------------------------------
printf '  通过 \033[32m%d\033[0m,失败 \033[31m%d\033[0m,警告 \033[33m%d\033[0m,跳过 %d\n' "$pass" "$fail" "$warn" "$skip"
if [ "$fail" -eq 0 ]; then
    printf '  \033[32m结论:这台机器通过了全部硬性检查。\033[0m\n'
    exit 0
fi
printf '  \033[31m结论:有 %d 项硬性检查没过(上面标 ✗ 的行)。\033[0m\n' "$fail"
printf '  排查入口:os-status(总览)、journalctl -b -u keel-mounts、docs/troubleshooting.md\n'
exit 1
