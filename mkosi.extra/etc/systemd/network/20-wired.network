# main 的有线网络:DHCP 取地址(决策 D15)
#
# 桌面 profile 会换成 NetworkManager(那时才需要 Wi-Fi 与图形化管理)。
# [Match] 里同名条目之间是"或"的关系,所以这里同时匹配 en* 和 eth*。
[Match]
Name=en*
Name=eth*

[Network]
# DHCP 由 networkd 自己负责 —— 它一度是坏的(坑 #29:ENOPKG),根因是
# /etc/machine-id 永远是 "uninitialized",现在由 /usr/lib/keel/mounts 在挂完
# /etc overlay 之后立刻补一个真 ID。**不要**为了"先有网"再把 DHCP 挪给 dhcpcd:
# 两个 DHCP 客户端同时抢一个网卡只会互相打架。
DHCP=yes
