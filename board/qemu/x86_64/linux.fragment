# keel2 kernel capabilities needed by W-1 and later.
# W-0 itself does not use any of these.
#
# CONFIG_BLK_DEV_DM lives under "if MD" in drivers/md/Kconfig, so it is
# silently dropped by merge_config unless CONFIG_MD is enabled too.
CONFIG_MD=y
CONFIG_EROFS_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
# vfat ESP needs these codepages; without them mount fails (W-1).
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# W-2 UKI boot: systemd-stub loads the .linux section with LoadImage, so the
# kernel must export a PE/COFF EFI stub. efivarfs is needed by bootctl and
# systemd-bless-boot.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
