#!/usr/bin/env bash
# keel 构建:装完包之后的定制(在主系统上跑,不 chroot;镜像树在 $BUILDROOT)
#
# 注意:mkosi 的脚本类设置默认值是按源目录里的 mkosi.<名字> 文件解析的,
# 而默认 initrd 镜像与主镜像共用同一个源目录,所以这里必须自己做防呆
# (见 docs/traps.md 坑 #1;mkosi.initrd.conf 里也清空了脚本设置)。
set -euo pipefail

R="${BUILDROOT:?BUILDROOT 未设置}"
log() { echo "keel-postinst: $*" >&2; }

if [ -e "$R/etc/initrd-release" ]; then
    log "这是 initrd 镜像,跳过全部定制"
    exit 0
fi

# ---------------------------------------------------------------------------
# /etc/resolv.conf -> systemd-resolved 的 stub
# (main 用 systemd-networkd + systemd-resolved,决策 D15)
# ---------------------------------------------------------------------------
ln -sfn /run/systemd/resolve/stub-resolv.conf "$R/etc/resolv.conf"

# ---------------------------------------------------------------------------
# nix:打开 flakes 与 nix 命令
# Debian 的 nix-bin / nix-setup-systemd 不带这个设置,而它是日常使用的刚需。
# 幂等:已经存在就不重复追加。
# ---------------------------------------------------------------------------
# v1.2 起 nix 由上游 tarball 供给(决策 D29/B1),这里写下多用户 daemon 需要的配置。
# ssl-cert-file 指**系统**的 CA bundle(ca-certificates 在 Packages 里):上游 installer
# 会把 tarball 里那份 nss-cacert 装进 profile 并设 NIX_SSL_CERT_FILE,我们不需要那层
# —— 系统 bundle 由 Debian 定期更新,而且不随 nix 版本变。
install -d -m 0755 "$R/etc/nix"
NIXCONF="$R/etc/nix/nix.conf"
[ -f "$NIXCONF" ] || { printf '# keel:nix 配置(v1.2 起 nix 由上游 tarball 供给,决策 D29)\n' >"$NIXCONF"; log "已创建 /etc/nix/nix.conf"; }
for kv in "build-users-group = nixbld" "experimental-features = nix-command flakes" "sandbox = true" "ssl-cert-file = /etc/ssl/certs/ca-certificates.crt"; do
    key="${kv%% =*}"
    if ! grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$NIXCONF"; then
        printf '%s\n' "$kv" >>"$NIXCONF"
        log "已向 /etc/nix/nix.conf 追加:$kv"
    fi
done

# ---------------------------------------------------------------------------
# 权限归一化:仓库里的权限位会**原样**进镜像(坑 #57)
#
# 背景(2026-09 实测):工作区里的文件如果因为 umask 之类的原因变成 0600,
# mkosi 会照抄进镜像 —— 而 systemd 的单元与 networkd 的配置**不是**由 root 读的:
#   * `/etc/systemd/network/*.network` 由 systemd-networkd 以 systemd-network 身份读
#     ⇒ 0600 时它读不到,于是**网络静默失效**(没有 DHCP、没有任何报错,只有
#       systemd 那句 "marked world-inaccessible" 的警告);
#   * 单元文件 0600 时 systemd 会打 world-inaccessible 警告(它自己是 root,还能读)。
# 更阴的是:**git 不跟踪读权限**(只记 100644/100755),所以这种损坏在 `git diff` 里
# 完全看不见 —— 只有构建出来的镜像会坏。
#
# 与其指望每个人 checkout 时的 umask 正确,不如在构建期把它们掰回来,并且**回读断言**。
# ---------------------------------------------------------------------------
mode_fix_files=(
    "$R/etc/motd"
    "$R/etc/sudoers.d/10-keel-admin"
    "$R/etc/ssh/sshd_config.d/10-keel.conf"
    "$R/etc/systemd/journald.conf.d/keel.conf"
    "$R/usr/lib/sysusers.d/keel.conf"
    "$R/usr/lib/systemd/system-preset/00-keel.preset"
)
for f in "$R"/usr/lib/systemd/system/keel-*.service "$R"/usr/lib/systemd/system/keel-*.timer \
         "$R"/etc/systemd/network/*.network "$R"/usr/lib/keel/repart.d/*.conf \
         "$R"/etc/sysctl.d/*.conf; do
    [ -e "$f" ] || continue
    mode_fix_files+=("$f")
done
for f in "${mode_fix_files[@]}"; do
    [ -e "$f" ] || continue
    # sudoers 在下面单独设成 0440;这里只保证其余的"能被对应的非 root 用户读到"
    case "$f" in */sudoers.d/*) continue ;; esac
    chmod 0644 "$f"
done
# 回读断言:凡是必须被**非 root 进程**读到的配置,权限位里"其他用户可读"这一位必须在。
# 这里刻意只看权限位、不 su 到 systemd-network:那个用户在 postinst 之后才由 sysusers 建。
for f in "$R"/etc/systemd/network/*.network; do
    [ -e "$f" ] || continue
    case "$(stat -c %a "$f")" in
        *[4567]) : ;;
        *)
            log "致命:$f 不是「其他用户可读」(mode $(stat -c %a "$f"))⇒ systemd-network 读不到它,网络会静默失效(坑 #57)"
            ls -l "$f" >&2
            exit 1
            ;;
    esac
done
log "权限归一化完成(systemd 单元 / networkd 配置 / motd / sshd drop-in 都设为 0644)"

# ---------------------------------------------------------------------------
# 登录账号与 SSH(决策 D21)
#
# 账号本身由 mkosi.extra/usr/lib/sysusers.d/keel.conf 交给 systemd-sysusers 建
# (它在本脚本之后、finalize 之前跑),密码与 authorized_keys 由 mkosi.finalize 处理。
# 这里只做两件"只能在这一步做"的事:
#   1. sudoers 文件的权限:sudo 要求它不能被组/其他人写,惯例是 0440。
#      git 只记 100644/100755 两种模式,所以不能在仓库里存成 0440 —— 必须构建时改。
#   2. sshd_config 的 Include:我们的 drop-in(PermitRootLogin no)只有在主配置
#      **文件靠前**的位置有一行 `Include /etc/ssh/sshd_config.d/*.conf` 时才生效
#      (sshd_config 是"第一条匹配生效")。Debian 13 默认配置本来就带,但这是
#      "发行版默认值",变了不会有任何提示 ⇒ 这里检查,缺了就补到**最前面**。
# ---------------------------------------------------------------------------
if [ -f "$R/etc/sudoers.d/10-keel-admin" ]; then
    chmod 0440 "$R/etc/sudoers.d/10-keel-admin"
    chown 0:0 "$R/etc/sudoers.d/10-keel-admin" 2>/dev/null || true
    log "sudoers.d/10-keel-admin 权限已设为 0440(admin 需要密码)"
else
    log "致命:mkosi.extra 里的 /etc/sudoers.d/10-keel-admin 不见了 —— admin 将无法 sudo"
    exit 1
fi

SSHD="$R/etc/ssh/sshd_config"
if [ -f "$SSHD" ]; then
    if ! grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' "$SSHD"; then
        tmp=$(mktemp)
        {
            echo "# keel:由 mkosi.postinst 补上(Debian 默认配置里本来就有这一行)"
            echo "Include /etc/ssh/sshd_config.d/*.conf"
            cat "$SSHD"
        } >"$tmp"
        cat "$tmp" >"$SSHD"
        rm -f "$tmp"
        log "sshd_config 里原本没有 sshd_config.d 的 Include,已补到文件最前面"
    fi
    # 回读:那一行真的在,而且我们的 drop-in 也有
    if ! grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' "$SSHD"; then
        log "致命:sshd_config 里的 Include 仍然缺失 ⇒ PermitRootLogin no 不会生效"
        exit 1
    fi
    [ -f "$R/etc/ssh/sshd_config.d/10-keel.conf" ] || {
        log "致命:mkosi.extra 里的 /etc/ssh/sshd_config.d/10-keel.conf 不见了"
        exit 1
    }
    log "sshd:已确认 drop-in 目录被 Include,PermitRootLogin no 会生效"
else
    log "警告:镜像里没有 /etc/ssh/sshd_config(openssh-server 没装?)"
fi

# ---------------------------------------------------------------------------
# 更新签名公钥(v1.2 1.1):必须真的在镜像里
#
# 公钥由 tools/sign.sh sync 在构建前放进 mkosi.extra/usr/share/keel/update-keys/,
# 这里回读断言。为什么要在构建期就拒:os-update fetch 是 fail-closed 的 —— 一份没带
# 公钥的镜像装上去之后**什么更新都装不上**,而那种坏要等真机更新那一刻才暴露。
# openssl 是运行时验签的唯一依赖(mkosi.conf.d/20-packages.conf 显式列了),一起断言。
# ---------------------------------------------------------------------------
keys_n=0
for f in "$R"/usr/share/keel/update-keys/*.pub; do
    [ -f "$f" ] && keys_n=$((keys_n + 1))
done
if [ "$keys_n" -lt 1 ]; then
    log "致命:镜像里没有更新签名公钥($R/usr/share/keel/update-keys/*.pub 一个都没有)"
    log "      ⇒ 装出来的机器会拒绝所有更新(fail-closed)。先跑 tools/sign.sh gen,再走 tools/build.sh。"
    exit 1
fi
[ -x "$R/usr/bin/openssl" ] || {
    log "致命:镜像里没有 /usr/bin/openssl ⇒ os-update 无法验签(v1.2 起不能更新)"
    exit 1
}
# 只数"至少一个 .pub"不够(对抗复核 2026-09-28):要确认**当前签名钥**那把真的在,
# 否则机器拿着一个不含签名钥的信任库,同样是"什么更新都装不上"。
active_key="$(cat "$R/usr/share/keel/update-keys/active-key-id" 2>/dev/null || true)"
if [ -z "$active_key" ] || [ ! -f "$R/usr/share/keel/update-keys/$active_key.pub" ]; then
    log "致命:镜像里的 active-key-id('${active_key:-空}')没有对应的公钥"
    log "      ⇒ 公钥同步有缺口(见 tools/sign.sh sync);拒绝出产物。"
    exit 1
fi
log "已确认镜像里有 $keys_n 个更新签名公钥(当前签名钥 $active_key)+ /usr/bin/openssl"

# ---------------------------------------------------------------------------
# 上游 nix 必须真的在数据骨架里(v1.2 B1/决策 D29):基底**不再有** nix-bin,
# 骨架里没有 nix 就等于装出一台"没有 nix 的 keel"。构建前 tools/nix-fetch.sh fetch
# 负责取(固定版本+sha256),这里回读断言。
# ---------------------------------------------------------------------------
nix_store_n=0
for d in "$R"/usr/share/keel/data-skeleton/nix/store/*-nix-*; do
    [ -d "$d" ] && nix_store_n=$((nix_store_n + 1))
done
if [ "$nix_store_n" -lt 1 ]; then
    log "致命:数据骨架里没有上游 nix($R/usr/share/keel/data-skeleton/nix/store/*-nix-*)"
    log "      ⇒ 先跑 tools/nix-fetch.sh fetch(tools/build.sh 会自动取)。"
    exit 1
fi
[ -L "$R/usr/bin/nix" ] || {
    log "致命:/usr/bin/nix 不是符号链接(命令入口应该在 mkosi.extra/usr/bin/ 里)"
    exit 1
}
log "已确认数据骨架里有 $nix_store_n 个上游 nix store path + /usr/bin/nix 入口"

# ---------------------------------------------------------------------------
# systemd-pcrlock-*:**v1.2 起解封**(决策 D20 的"将来做 Secure Boot 时解封"已兑现)
#
# v1 在这里把它们 mask 成 /dev/null、并在 preset 里 disable;v1.2 两处都撤掉,
# 因为 Secure Boot 已经打开、而且 TPM 封印(1.3)需要这些单元能跑。
# 这里改成**反向回读断言**:镜像里不许再有 mask 链接 —— 这是"解封了没有"的构建期判据。
# 注意:VM 里 vTPM 没有真实固件 event log 时,个别单元仍可能失败;那是实验环境没有
# 测量链,不是被我们关掉(真机行为取决于固件日志与 TPM 能力,见 docs/traps.md #40)。
# ---------------------------------------------------------------------------
install -d -m 0755 "$R/etc/systemd/system"
pcrlock_masks=0
for f in "$R"/etc/systemd/system/systemd-pcrlock*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    pcrlock_masks=$((pcrlock_masks + 1))
done
if [ "$pcrlock_masks" -ne 0 ]; then
    log "致命:镜像里还有 $pcrlock_masks 个 /etc/systemd/system/systemd-pcrlock* 条目"
    log "      ⇒ v1.2 起必须解封(决策 D20);删掉 mask 再构建。"
    ls -l "$R"/etc/systemd/system/systemd-pcrlock* >&2 || true
    exit 1
fi
log "已确认 systemd-pcrlock 单元未被 mask(v1.2 解封;Secure Boot 已开)"

# ---------------------------------------------------------------------------
# 把仓库文档带进镜像:/etc/motd 里指向 /usr/share/doc/keel/,
# 系统离线时也能查到装机和更新的说明。
# ---------------------------------------------------------------------------
if [ -n "${SRCDIR:-}" ] && [ -d "${SRCDIR}/docs" ]; then
    install -d -m 0755 "$R/usr/share/doc/keel"
    for f in "$SRCDIR"/docs/*.md "$SRCDIR/README.md"; do
        [ -f "$f" ] && install -m 0644 "$f" "$R/usr/share/doc/keel/"
    done
fi

# ---------------------------------------------------------------------------
# repart 的 CopyFiles 源必须存在,否则构建到输出阶段才会报错
# ---------------------------------------------------------------------------
install -d -m 0755 "$R/efi" "$R/boot"

# ---------------------------------------------------------------------------
# os-install 用的 repart 定义 → /usr/lib/keel/repart-install.d
#
# 装机 U 盘里跑的 `os-install <目标盘>` 会执行:
#     systemd-repart --empty=force --definitions=/usr/lib/keel/repart-install.d <目标盘>
# 所以这份定义必须**在镜像里**。第一版漏了这一步,真机(VM)上的表现是:
#     找不到 repart 定义目录:/usr/lib/keel/repart-install.d(这个镜像不完整?)
#
# 与构建时用的 repart/install/ 是同一份文件(单一事实来源),只做一处改动:
# **删掉 CopyFiles=**。原因:repart 的 CopyFiles 源在既没有 --root=、也没有
# --copy-source= 时解析到**宿主机的真实 /** —— mkosi 构建时会传镜像树,运行时不会。
# 于是运行时跑这份定义会去拷 /proc /sys /run /data …(而 os-install 本来就自己
# dd 根分区、mkfs data 分区、复制 ESP 内容,这些 CopyFiles 在运行时既没用又有害)。
# 分区名/类型/尺寸全部保留 ⇒ 建出来的分区表与构建时完全一致
# (tools/verify.sh 会把两份定义各 dry-run 一次做对比)。
#
# v1.1 追加:同时删掉 `Format=erofs`。理由和 CopyFiles= 是同一类:
#   systemd-repart 拒绝在**没有源文件**的情况下格式化 erofs
#     Cannot format erofs filesystem without source files, refusing.
#   而运行时的定义恰恰没有 CopyFiles(上面那条)⇒ 留着 Format=erofs
#   会让 os-install 的建表**直接失败**。
#   这里也**不需要**任何文件系统:
#     - root-a:os-install 紧接着把 live 根(erofs 镜像)整块 dd 进去;
#     - root-b:空槽,第一次 os-update 才把 erofs 镜像 dd 进来。
#   esp(vfat)与 data(ext4)的 Format= **保留** —— repart 必须真的建出这两个文件系统。
# ---------------------------------------------------------------------------
install -d -m 0755 "$R/usr/lib/keel/repart-install.d"
if [ -n "${SRCDIR:-}" ] && [ -d "${SRCDIR}/repart/install" ]; then
    n_defs=0
    for f in "$SRCDIR"/repart/install/*.conf; do
        [ -f "$f" ] || continue
        # 用 sed 而不是 grep -v:grep 在"一行都没输出"时返回 1,配上 set -e 会误杀构建
        sed -e '/^[[:space:]]*CopyFiles=/d' -e '/^[[:space:]]*Format=erofs[[:space:]]*$/d' \
            "$f" >"$R/usr/lib/keel/repart-install.d/$(basename "$f")"
        n_defs=$((n_defs + 1))
    done
    if [ "$n_defs" -lt 4 ]; then
        log "致命:$SRCDIR/repart/install 里只有 $n_defs 个 .conf,os-install 需要完整的四分区定义"
        exit 1
    fi
    log "已装 repart 安装定义($n_defs 个,去掉 CopyFiles= 与 Format=erofs)→ $R/usr/lib/keel/repart-install.d"
else
    # 少了它装出来的 U 盘根本装不了机,而且要到目标机上手敲 os-install 才会发现 ⇒ 直接失败
    log "致命:找不到 \${SRCDIR}/repart/install(当前 SRCDIR='${SRCDIR:-}')"
    log "      没有它 os-install 在运行时就没有分区定义。检查是不是把 BuildSources= 设空了(坑 #22)"
    exit 1
fi

# /etc/machine-id:mkosi 默认写入 "uninitialized",首启由 systemd 生成真正的 ID。
# 这里只做断言,防止有人设了 MachineId= 把同一个 ID 烤进所有装机实例。
if [ -f "$R/etc/machine-id" ] && [ "$(cat "$R/etc/machine-id")" != "uninitialized" ]; then
    log "警告:/etc/machine-id 不是 uninitialized —— 请确认不是有意为之,"
    log "      否则所有用这个镜像装出来的机器会共用同一个 machine-id"
fi

log "完成"

# ---------------------------------------------------------------------------
# os-release:发行版标识改成 keel(基底仍标在 ID_LIKE 里,工具链照常识别 Debian)
# ---------------------------------------------------------------------------
R="${BUILDROOT:-/}"
if [ -f "$R/usr/lib/os-release" ]; then
    sed -i -e 's/^NAME=.*/NAME="keel"/' \
           -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"keel ${IMAGE_VERSION:-}\"(Debian trixie 基底)\"/" \
           -e 's/^ID=.*/ID=keel/' \
           -e 's/^ID_LIKE=.*/ID_LIKE="debian"/' \
           -e 's|^HOME_URL=.*|HOME_URL="https://github.com/xxn1001/keel"|' \
        "$R/usr/lib/os-release"
    for kv in 'ID_LIKE="debian"' 'IMAGE_ID=keel'; do
        key=${kv%%=*}
        grep -q "^${key}=" "$R/usr/lib/os-release" || echo "$kv" >>"$R/usr/lib/os-release"
    done
    log "os-release 已改成 keel(ID_LIKE=debian)"
fi
